% rmt.cz — random matrices, structured.
% Sugar over randn/qr/eye for the matrices you actually reach for:
% symmetric, SPD (chol-safe), orthogonal (Haar), permutations, correlation,
% row-stochastic, and the Gaussian orthogonal ensemble.
% Reproducible under rng(seed), like everything random.

% randsym(n): a random symmetric n x n matrix with N(0,1)-scale entries,
% (A + A') / 2; eig gives real spectra.
% e.g. rng(1); let S = randsym(4); max(abs(S - S')) %= 0
let randsym = fn n -> (
  let a = randn(n);
  (a + a') / 2)

% wishart(n): A'A for a standard normal n x n A — symmetric positive
% semidefinite (the Wishart form).
% e.g. rng(1); all(eig(wishart(4)).values >= -1e-9) %= true
let wishart = fn n -> (
  let a = randn(n);
  a' * a)

% randspd(n): a symmetric positive definite matrix, wishart(n) + I — safe
% for chol and for cg.
% e.g. rng(1); let A = randspd(4); let L = chol(A); max(abs(L * L' - A)) < 1e-9 %= true
let randspd = fn n -> wishart(n) + eye(n)

% randorth(n): a Haar-distributed random orthogonal matrix (Q of the QR
% of a Gaussian matrix, signs fixed).
% e.g. rng(1); let Q = randorth(4); max(abs(Q' * Q - eye(4))) < 1e-12 %= true
let randorth = fn n -> (
  let f = qr(randn(n));
  f.Q * diag(sign(diag(f.R))))

% randperm(n): a random permutation of 1..n, as a row.
% e.g. rng(1); sort(randperm(6))            %= [1, 2, 3, 4, 5, 6]
let randperm = fn n -> (
  let r = rand(1, n);
  r ~> (fn x -> sum(r <= x)))

% permmat(p): the permutation matrix of the permutation p (P * x reorders).
% e.g. permmat([2, 3, 1])                   %= [0, 1, 0; 0, 0, 1; 1, 0, 0]
let permmat = fn p -> (
  let n = numel(p);
  let I = eye(n);
  I[p, :])

% randcorr(n): a random correlation matrix — unit diagonal, SPD, from a
% Wishart rescaled by its standard deviations.
% e.g. rng(1); diag(randcorr(3))'           %= [1, 1, 1]
let randcorr = fn n -> (
  let S = wishart(n);
  let d = diag(1 ./ sqrt(diag(S)));
  d * S * d)

% randstoch(n): a random row-stochastic matrix (nonnegative, rows sum
% to 1) — a Markov transition matrix.
% e.g. rng(1); format(4); sum(randstoch(4), 2)' %= [1.000, 1.000, 1.000, 1.000]
let randstoch = fn n -> (
  let r = rand(n);
  r ./ repmat(sum(r, 2), 1, n))

% goe(n): a Gaussian orthogonal ensemble matrix — symmetric, off-diagonal
% variance 1/2, diagonal variance 1; its spectrum follows Wigner's semicircle.
% e.g. rng(1); let G = goe(5); max(abs(G - G')) %= 0
let goe = fn n -> (
  let a = randn(n);
  (a + a') / sqrt(2 * n))
