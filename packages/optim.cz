# optim.cz — multivariate optimization for Cozy (design entry 3),
# built on autodiff.cz's exact gradients. The architecture is layered:
# an unconstrained BFGS core, maximization as negation, box bounds by
# gradient projection, and general equality/inequality constraints by
# an augmented Lagrangian whose inner solver IS minimize — solvers as
# packages, composing with themselves. Every objective must flow dual
# numbers (elementwise ops, matmul, reductions; see the manual's dual
# section). Results are records: {x, fx, iters, converged}.
# See tests/59_optim.test.

load("packages/autodiff.cz")

# internal: dot product of two columns.
let op_dot = fn x, y -> sum(x .* y)
# internal: Euclidean norm of a column.
let op_norm = fn x -> sqrt(sum(x .* x))

# internal: Armijo backtracking — the largest t in {1, 1/2, ...} with
# sufficient decrease f(x + t p) <= fx + 1e-4 t g'p; gives up below 1e-16.
let op_bt = fn f, x, fx, slope, p -> (
  let t = 1.0;
  let stop = false;
  while !stop do
    if f(x + t * p) <= fx + 0.0001 * t * slope then (stop = true)
    else (t = t / 2) end;
    if t < 1e-16 then (stop = true) end
  end;
  t
)

# minimize(f, x0): unconstrained minimization by BFGS with an inverse-
# Hessian update and Armijo line search; gradients are EXACT (dual
# numbers through f), so f must flow duals. Converges when the gradient
# norm falls below 1e-8 (relative to 1 + |fx|); gives up after 500
# iterations. Returns {x, fx, iters, converged}. Also written as the
# binder minimize[x = x0] f(x).
# e.g. minimize(fn x -> (x[1] - 3)^2 + (x[2] + 1)^2, [0.0; 0.0]).x' %= [3, -1]
# e.g. (minimize[x = [1.0; 1.0]] sum(x .* x)).converged %= true
let minimize = fn f, x0 -> (
  let g = grad(f);
  let x = 1.0 * x0;
  let n = numel(x);
  let H = 1.0 * eye(n);
  let gx = g(x);
  let iters = 0;
  let converged = op_norm(gx) <= 1e-8 * (1 + abs(f(x)));
  while !converged & (iters < 500) do
    let p = -(H * gx);
    let slope = op_dot(gx, p);
    if slope >= 0 then (
      # H lost positive definiteness numerically: steepest-descent restart
      H = 1.0 * eye(n);
      p = -gx;
      slope = op_dot(gx, p)
    ) end;
    let fx = f(x);
    let t = op_bt(f, x, fx, slope, p);
    let s = t * p;
    let xn = x + s;
    let gn = g(xn);
    let y = gn - gx;
    let sy = op_dot(s, y);
    if sy > 1e-12 then (
      let rho = 1 / sy;
      let E = eye(n) - rho * (s * y');
      H = E * H * E' + rho * (s * s')
    ) end;
    x = xn;
    gx = gn;
    iters = iters + 1;
    if op_norm(gx) <= 1e-8 * (1 + abs(f(x))) then (converged = true) end
  end;
  {x = x, fx = f(x), iters = iters, converged = converged}
)

# maximize(f, x0): maximization as negation — same record as minimize,
# with fx being f's own value at the maximum.
# e.g. maximize(fn x -> -(x[1] - 2)^2, [0.0]).x[1] %= 2
let maximize = fn f, x0 -> (
  let r = minimize(fn x -> -f(x), x0);
  {x = r.x, fx = f(r.x), iters = r.iters, converged = r.converged}
)

# internal: elementwise clamp of x into [lb, ub].
let op_clip = fn x, lb, ub -> min(max(x, lb), ub)

# minimize_box(f, x0, lb, ub): minimization under box bounds lb <= x <= ub
# by projected gradient with Armijo backtracking; converges on the
# projected-gradient residual ||x - clip(x - g, lb, ub)||.
# e.g. minimize_box(fn x -> (x[1] - 3)^2, [0.0], [0.0], [2.0]).x[1] %= 2
let minimize_box = fn f, x0, lb, ub -> (
  let g = grad(f);
  let x = op_clip(1.0 * x0, lb, ub);
  let iters = 0;
  let converged = op_norm(x - op_clip(x - g(x), lb, ub)) <= 1e-8;
  while !converged & (iters < 2000) do
    let gx = g(x);
    let fx = f(x);
    let t = 1.0;
    let stop = false;
    while !stop do
      if f(op_clip(x - t * gx, lb, ub)) <= fx - 0.0001 * t * op_dot(gx, gx) then (stop = true)
      else (t = t / 2) end;
      if t < 1e-16 then (stop = true) end
    end;
    x = op_clip(x - t * gx, lb, ub);
    iters = iters + 1;
    if op_norm(x - op_clip(x - g(x), lb, ub)) <= 1e-8 then (converged = true) end
  end;
  {x = x, fx = f(x), iters = iters, converged = converged}
)

# maximize_box(f, x0, lb, ub): box-bounded maximization (negation of
# minimize_box).
# e.g. maximize_box(fn x -> -(x[1] - 3)^2, [0.0], [0.0], [2.0]).x[1] %= 2
let maximize_box = fn f, x0, lb, ub -> (
  let r = minimize_box(fn x -> -f(x), x0, lb, ub);
  {x = r.x, fx = f(r.x), iters = r.iters, converged = r.converged}
)

# internal: does record c carry field name?
let op_has = fn c, name -> any(fields(c) == name)

# minimize_con_al(f, x0, cons): the pure augmented-Lagrangian solver
# behind minimize_con — equality (cons.eq) and inequality (cons.ineq)
# constraints by multiplier updates with minimize as the inner solver;
# the tier0 path when no NLopt backend is built in.
# e.g. format(4); minimize_con_al(fn x -> sum(x .* x), [2.0; 2.0], {eq = fn x -> [sum(x) - 2]}).x' %= [1.000, 1.000]
let minimize_con_al = fn f, x0, cons -> (
  let heq = if op_has(cons, "eq") then cons.eq else fn x -> zeros(1, 1) end;
  let gin = if op_has(cons, "ineq") then cons.ineq else fn x -> zeros(1, 1) - 1 end;
  let lam = 0.0 * heq(1.0 * x0);
  let mu = 0.0 * gin(1.0 * x0);
  let rho = 100.0;
  let x = 1.0 * x0;
  let outer = 0;
  let converged = false;
  let iters = 0;
  while !converged & (outer < 30) do
    let L = fn z -> f(z) + op_dot(lam, heq(z)) + rho / 2 * op_dot(heq(z), heq(z))
                  + 1 / (2 * rho) * (op_dot(max(0 * mu, mu + rho * gin(z)), max(0 * mu, mu + rho * gin(z))) - op_dot(mu, mu));
    let xprev = 1.0 * x;
    let r = minimize(L, x);
    x = r.x;
    iters = iters + r.iters;
    let h = heq(x);
    let gv = gin(x);
    let viol = op_norm(h) + op_norm(max(0 * gv, gv));
    lam = lam + rho * h;
    mu = max(0 * mu, mu + rho * gv);
    outer = outer + 1;
    % converged when the constraints hold and either the inner solver is
    % satisfied or the iterate has stopped moving between outer rounds —
    % under large rho the inner gradient test can be unreachable at the
    % exact answer, and without the stall test the loop burns its full
    % budget standing still (the book's life-cycle problem, 14631 iters)
    if viol <= 1e-7 & (r.converged | op_norm(x - xprev) <= 1e-10 * (1 + op_norm(x)))
      then (converged = true)
    else (rho = rho * 2) end
  end;
  {x = x, fx = f(x), iters = iters, converged = converged}
)

# minimize_con_nl(f, x0, cons): minimize_con through the NLopt backend
# (SLSQP fed exact dual gradients and Jacobians); errors on builds
# without OPTIM=nlopt — call minimize_con, which dispatches.
# e.g. buildinfo().optim == "nlopt" || true %= true
let minimize_con_nl = fn f, x0, cons -> (
  let opts = {alg = "slsqp"};
  let opts = if op_has(cons, "eq") then setfield(opts, "eq", cons.eq) else opts end;
  let opts = if op_has(cons, "ineq") then setfield(opts, "ineq", cons.ineq) else opts end;
  nlmin(f, x0, opts)
)

# minimize_con(f, x0, cons): constrained minimization. cons is a record
# with either or both of eq = fn x -> column h(x) (driven to 0) and
# ineq = fn x -> column g(x) (driven to <= 0). Dispatches to SLSQP
# when buildinfo().optim is "nlopt", else to the augmented Lagrangian;
# results agree to the pinned tolerances on both paths.
# e.g. format(4); minimize_con(fn x -> sum(x .* x), [2.0; 2.0], {eq = fn x -> [sum(x) - 2]}).x' %= [1.000, 1.000]
# e.g. format(4); minimize_con(fn x -> x[1], [1.0], {ineq = fn x -> [1 - x[1]]}).x[1] %= 1.000
let minimize_con = fn f, x0, cons -> (
  if buildinfo().optim == "nlopt" then minimize_con_nl(f, x0, cons)
  else minimize_con_al(f, x0, cons) end)

# maximize_con(f, x0, cons): constrained maximization (negation of
# minimize_con) — the life-cycle and portfolio problems of the book.
# e.g. format(4); maximize_con(fn x -> x[1] * x[2], [1.0; 1.0], {eq = fn x -> [x[1] + x[2] - 2]}).x' %= [1.000, 1.000]
let maximize_con = fn f, x0, cons -> (
  let r = minimize_con(fn x -> -f(x), x0, cons);
  {x = r.x, fx = f(r.x), iters = r.iters, converged = r.converged}
)

# minimize_newton(f, x0): Newton's method on EXACT derivatives — the
# gradient from dual numbers, the Hessian from hyper-duals, the step
# from the linear solver — with Levenberg damping when the Newton
# direction is not a descent direction. One step lands exactly on a
# positive-definite quadratic's minimum. Never dispatched to NLopt.
# e.g. minimize_newton(fn x -> (x[1] - 3)^2 + 2 * (x[2] + 1)^2, [0.0; 0.0]).iters %= 1
let minimize_newton = fn f, x0 -> (
  let g = grad(f);
  let Hf = hess(f);
  let x = 1.0 * x0;
  let n = numel(x);
  let iters = 0;
  let gx = g(x);
  let converged = op_norm(gx) <= 1e-8 * (1 + abs(f(x)));
  let lam = 0.0;
  while !converged & (iters < 100) do
    let p = -((Hf(x) + lam * eye(n)) \ gx);
    let slope = op_dot(gx, p);
    if slope >= 0 then (
      lam = max(1e-4, 10 * lam);
      p = -((Hf(x) + lam * eye(n)) \ gx);
      slope = op_dot(gx, p)
    ) end;
    if slope >= 0 then (p = -gx; slope = op_dot(gx, p)) end;
    let fx = f(x);
    let t = op_bt(f, x, fx, slope, p);
    x = x + t * p;
    gx = g(x);
    iters = iters + 1;
    lam = lam / 4;
    if op_norm(gx) <= 1e-8 * (1 + abs(f(x))) then (converged = true) end
  end;
  {x = x, fx = f(x), iters = iters, converged = converged}
)

# maximize_newton(f, x0): Newton maximization (negation of minimize_newton).
# e.g. maximize_newton(fn x -> -(x[1] - 5)^2, [0.0]).x[1] %= 5
let maximize_newton = fn f, x0 -> (
  let r = minimize_newton(fn x -> -f(x), x0);
  {x = r.x, fx = f(r.x), iters = r.iters, converged = r.converged}
)
