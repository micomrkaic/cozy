% dsge.cz — a mini Dynare: write a dynamic stochastic general equilibrium
% model the way Dynare's model block reads, and get its steady state, its
% solution to first or second order, impulse responses, simulations and
% moments.
%
%   let m = dsge.model({vars = "c k a", shocks = "e",
%                 params = {alpha = 0.33, beta = 0.99, ...},
%                 model = ["c^(-sigma) = beta * c(+1)^(-sigma) * (...)";
%                          "c + k = exp(a) * k(-1)^alpha + (1 - delta) * k(-1)";
%                          "a = rho * a(-1) + e"]})
%   let s = dsge.solve(m)             % steady state + decision rule
%   dsge.irf(s, "e", 40)              % a record of columns, one per variable
%
% Timing is Dynare's: x is decided today, x(-1) yesterday, x(+1) is
% tomorrow's value in expectation — so a stock chosen today for use
% tomorrow enters production as k(-1). One lead and one lag per variable;
% for a longer lead or lag add a variable (x1 = x(+1), and write x1(+1)).
% To second order that is exact only where x enters linearly: if x(+2) sits
% inside a nonlinear term, give the whole term a variable instead
% (z = g(x(+1)), and write z(+1)), as Dynare does, or the expectation of a
% curved function is taken at the wrong date and the risk correction is off.
%
% How it works. The equations are compiled once into a residual function
% f(v, p) of v = [y(+1); y; y(-1); shocks]. The steady state solves
% f(y, y, y, 0) = 0 by Newton's method, and the model is linearised around
% it; both Jacobians are EXACT — dual numbers, no differencing. The linear
% system A y(+1) + B y + C y(-1) + D e = 0 is solved for the decision rule
% y = P y(-1) + Q e by cyclic reduction (Dynare's dr = cycle_reduction),
% which needs only linear solves, so the same code runs in the browser.
% The Blanchard-Kahn count is read from the solution's own eigenvalues.
% Variables are deviations from the steady state — log deviations if you
% write the model in logs. Cross-checked against an ordered-QZ solver
% (SciPy) and Gali's closed form; see tests/71_dsge.test.
%
% An occasionally binding constraint — an interest rate that cannot fall
% below a floor, investment that cannot be undone — is handled piecewise
% linearly (dsge.occbin, Guerrieri and Iacoviello's OccBin): two regimes,
% each linear, and the periods in which the constraint binds found by
% guess and verify. Cross-checked against Dynare's OccBin; see
% tests/77_occbin.test.
%
% The solution to second order (dsge.solve2) adds the curvature of the
% decision rule and the effect of risk; dsge.simulate2, dsge.irf2 and
% dsge.mean2 use it. Cross-checked against Dynare's stoch_simul(order = 2);
% see tests/78_dsge2.test.
%
% The public face is the record dsge: dsge.model, dsge.steady, dsge.bk,
% dsge.solve, dsge.irf, dsge.simulate, dsge.moments, dsge.vardecomp,
% dsge.occbin, dsge.solve2, dsge.simulate2, dsge.irf2, dsge.mean2, and the
% ready-made models dsge.rbc, dsge.nk and dsge.zlb. The functions behind it (dsge_*)
% and the helpers (dg_*) are ordinary globals: keep() must spare them.
% To unload the package, clear("packages/dsge.cz"): clear("dsge") finds the
% record first and removes only that.

% internal: can the one-character string ch start a name?
let dg_alpha = fn ch -> ((ch >= "a") && (ch <= "z")) || ((ch >= "A") && (ch <= "Z")) || (ch == "_") || (ch > "~")
% internal: is the one-character string ch a digit?
let dg_digit = fn ch -> (ch >= "0") && (ch <= "9")

% The functions a model equation may call (all differentiate exactly).
let dg_funcs = ["exp", "log", "ln", "log10", "log2", "sqrt", "cbrt", "abs", "sign", "min", "max",
                "sin", "cos", "tan", "asin", "acos", "atan", "sinh", "cosh", "tanh",
                "asinh", "acosh", "atanh", "erf", "erfc", "gamma", "lgamma"]

% internal: position of the string s in the string array names, 0 if absent.
let dg_find = fn names, s -> (
  let k = 0;
  for i = 1 : numel(names) do if names[i] == s then (k = i) end end;
  k
)

% internal: the words of a space- or comma-separated list, as a string row.
let dg_words = fn s -> (
  let t = trim(strrep(strrep(s, ",", " "), ";", " "));
  while contains(t, "  ") do t = strrep(t, "  ", " ") end;
  if t == "" then error("dsge: an empty list of names") end;
  strsplit(t, " ")
)

% internal: refuse names that cannot be model names.
let dg_checknames = fn names, what -> (
  let bad = ["let", "in", "fn", "if", "then", "else", "elseif", "end", "for", "while", "do",
             "break", "continue", "return", "true", "false", "null", "where"];
  for i = 1 : numel(names) do (
    let nm = names[i];
    if dg_find(bad, nm) > 0 then error("dsge: '{}' is a reserved word and cannot name a {}", nm, what) end;
    if !dg_alpha(nm[1]) then error("dsge: '{}' is not a valid {} name", nm, what) end;
    if contains(nm, "__") then error("dsge: {} names may not contain '__' (got '{}')", what, nm) end;
    for j = 1 : i - 1 do
      if names[j] == nm then error("dsge: the {} '{}' is listed twice", what, nm) end
    end
  ) end;
  true
)

% internal: the time shift written inside x( ... ), e.g. "+1" -> 1; anything
% that is not a signed whole number is an error naming the equation.
let dg_shift = fn inner, name, eqno -> (
  let L = length(inner);
  let sgn = 1; let i = 1;
  if (L >= 1) && ((inner[1] == "+") || (inner[1] == "-")) then (
    if inner[1] == "-" then (sgn = -1) end;
    i = 2
  ) end;
  let ok = i <= L;
  for j = i : L do if !dg_digit(inner[j]) then (ok = false) end end;
  if !ok then
    error("dsge: equation {}: '{}({})' is not a time shift — write {}(+1) or {}(-1), and use * to multiply",
          eqno, name, inner, name, name)
  end;
  sgn * num(inner[i : L])
)

% internal: rewrite one side of an equation from Dynare's notation into
% Cozy source: x(+1) -> x__f, x(-1) -> x__b, x stays x. Returns the text and
% which variables appeared with a lead and with a lag.
let dg_rewrite = fn s, vars, shocks, pnames, eqno -> (
  let nv = numel(vars);
  let lead = zeros(1, nv); let lag = zeros(1, nv);
  let out = ""; let L = length(s); let i = 1;
  while i <= L do (
    let ch = s[i];
    if dg_digit(ch) || ((ch == ".") && (i < L) && dg_digit(s[min(i + 1, L)])) then (
      let j = i;
      while (j <= L) && (dg_digit(s[min(j, L)]) || (s[min(j, L)] == ".")) do j = j + 1 end;
      if (j < L) && ((s[j] == "e") || (s[j] == "E")) then (
        let k = j + 1;
        if (k < L) && ((s[k] == "+") || (s[k] == "-")) then (k = k + 1) end;
        if dg_digit(s[k]) then (
          while (k <= L) && dg_digit(s[min(k, L)]) do k = k + 1 end;
          j = k
        ) end
      ) end;
      out = out + s[i : j - 1];
      i = j
    ) elseif dg_alpha(ch) then (
      let j = i;
      while (j <= L) && (dg_alpha(s[min(j, L)]) || dg_digit(s[min(j, L)])) do j = j + 1 end;
      let name = s[i : j - 1];
      let k = j;
      while (k <= L) && (s[min(k, L)] == " ") do k = k + 1 end;
      let call = (k <= L) && (s[min(k, L)] == "(");
      let iv = dg_find(vars, name);
      let ie = dg_find(shocks, name);
      let shift = 0;
      if ((iv > 0) || (ie > 0)) && call then (
        let c = k + 1;
        while (c <= L) && (s[min(c, L)] != ")") do c = c + 1 end;
        if c > L then error("dsge: equation {}: unclosed '(' after {}", eqno, name) end;
        shift = dg_shift(strrep(s[k + 1 : c - 1], " ", ""), name, eqno);
        j = c + 1
      ) end;
      if iv > 0 then (
        if shift == 0 then (out = out + name)
        elseif shift == 1 then ( out = out + name + "__f"; lead[iv] = 1 )
        elseif shift == -1 then ( out = out + name + "__b"; lag[iv] = 1 )
        else error("dsge: equation {}: {}({}) — only one lead or lag is supported; define an auxiliary variable (say {}1 = {}({})) and shift that",
                   eqno, name, shift, name, name, sign(shift))
        end
      ) elseif ie > 0 then (
        if shift != 0 then error("dsge: equation {}: the shock {} cannot carry a lead or lag; give it an AR(1) variable instead", eqno, name) end;
        out = out + name
      ) elseif dg_find(pnames, name) > 0 then (
        out = out + name
      ) elseif call && (dg_find(dg_funcs, name) > 0) then (
        out = out + name
      ) else
        error("dsge: equation {}: '{}' is not a variable, a shock, a parameter or a function a model may use", eqno, name)
      end;
      i = j
    ) else (
      out = out + ch;
      i = i + 1
    ) end
  ) end;
  {text = out, lead = lead, lag = lag}
)

% internal: a record of values -> a column in the order of names; missing
% names take the fallback, unknown ones are an error.
let dg_col = fn r, names, fallback, what -> (
  let n = numel(names);
  let out = fallback * ones(n, 1);
  let fr = fields(r);
  for i = 1 : numel(fr) do (
    let k = dg_find(names, fr[i]);
    if k == 0 then error("dsge: {} names '{}', which is not in the model", what, fr[i]) end;
    out[k] = getfield(r, fr[i])
  ) end;
  out
)

% internal: the columns of Y as a record of columns named by names (a table).
let dg_table = fn Y, names -> (
  let r = {};
  for i = 1 : numel(names) do r = setfield(r, names[i], Y[:, i]) end;
  r
)

% dsge.model(spec): compile a model from a spec record.
% In the spec, vars and shocks are space-separated name lists, params a
% record of values, and model a string column of equations in Dynare's
% notation (x(+1), x(-1); "lhs = rhs" or a bare expression meaning
% "= 0"). Optional: sd, a record of shock standard
% deviations (default 1); init, a record of starting values for the
% steady-state search (default 1); steady, a function of the parameter
% record returning the steady state as a record, used instead of the search.
% Returns the model record that dsge.steady, dsge.bk and dsge.solve take.
% e.g. let m = dsge.model(dsge.rbc()); [m.n, m.k] %= [5, 1]
% e.g. dsge.model(dsge.rbc()).vars                %= ["y", "c", "i", "k", "a"]
% e.g. dsge.model({vars = "x", shocks = "e", params = {r = 0.5}, model = ["x = r * x(-1) + e"]}).lag %= [1]
let dsge_model = fn spec -> (
  let fs = fields(spec);
  let need = ["vars", "shocks", "params", "model"];
  for i = 1 : 4 do
    if dg_find(fs, need[i]) == 0 then error("dsge: the model record needs a '{}' field", need[i]) end
  end;
  let known = ["vars", "shocks", "params", "model", "sd", "init", "steady"];
  for i = 1 : numel(fs) do
    if dg_find(known, fs[i]) == 0 then
      error("dsge: unknown field '{}' (the fields are vars, shocks, params, model, sd, init, steady)", fs[i])
    end
  end;
  let vars = dg_words(spec.vars);
  let shocks = dg_words(spec.shocks);
  let pnames = fields(spec.params);
  let n = numel(vars); let k = numel(shocks); let np = numel(pnames);
  dg_checknames(vars, "variable"); dg_checknames(shocks, "shock"); dg_checknames(pnames, "parameter");
  for i = 1 : k do
    if dg_find(vars, shocks[i]) > 0 then error("dsge: '{}' is both a variable and a shock", shocks[i]) end
  end;
  for i = 1 : np do
    if (dg_find(vars, pnames[i]) > 0) || (dg_find(shocks, pnames[i]) > 0) then
      error("dsge: '{}' is both a parameter and a variable or shock", pnames[i])
    end
  end;
  let parts = strsplit(strjoin(spec.model, ";"), ";");
  let eqs = parts[map(fn q -> trim(q) != "", parts)];
  let neq = numel(eqs);
  if neq != n then error("dsge: {} equations for {} variables — a model needs one equation per variable", neq, n) end;
  let lead = zeros(1, n); let lag = zeros(1, n);
  let body = "";
  for q = 1 : neq do (
    let sides = strsplit(eqs[q], "=");
    if numel(sides) > 2 then error("dsge: equation {} has more than one '='", q) end;
    let lhs = dg_rewrite(trim(sides[1]), vars, shocks, pnames, q);
    lead = max(lead, lhs.lead); lag = max(lag, lhs.lag);
    let res = "(" + lhs.text + ")";
    if numel(sides) == 2 then (
      let rhs = dg_rewrite(trim(sides[2]), vars, shocks, pnames, q);
      lead = max(lead, rhs.lead); lag = max(lag, rhs.lag);
      res = res + " - (" + rhs.text + ")"
    ) end;
    body = body + (if q > 1 then "; " else "" end) + res
  ) end;
  let src = "fn v__, p__ -> (";
  for i = 1 : np do src = src + "let " + pnames[i] + " = p__." + pnames[i] + "; " end;
  for i = 1 : n do (
    if lead[i] > 0 then (src = src + "let " + vars[i] + "__f = v__[" + str(i) + "]; ") end;
    src = src + "let " + vars[i] + " = v__[" + str(n + i) + "]; ";
    if lag[i] > 0 then (src = src + "let " + vars[i] + "__b = v__[" + str(2 * n + i) + "]; ") end
  ) end;
  for i = 1 : k do src = src + "let " + shocks[i] + " = v__[" + str(3 * n + i) + "]; " end;
  src = src + "[" + body + "])";
  let hasinit = dg_find(fs, "init") > 0;
  let hassd = dg_find(fs, "sd") > 0;
  let hassteady = dg_find(fs, "steady") > 0;
  {vars = vars, shocks = shocks, pnames = pnames, params = spec.params, n = n, k = k,
   lead = lead, lag = lag, eqs = eqs, src = src, f = eval(src),
   init = dg_col(if hasinit then spec.init else {} end, vars, 1.0, "init"),
   sd = dg_col(if hassd then spec.sd else {} end, shocks, 1.0, "sd"),
   hassteady = hassteady,
   steadyfn = if hassteady then spec.steady else (fn p -> {}) end}
)

% internal: the model's parameters with the overrides in over applied.
let dg_params = fn m, over -> (
  let p = m.params;
  let fo = fields(over);
  for i = 1 : numel(fo) do (
    if dg_find(m.pnames, fo[i]) == 0 then error("dsge: '{}' is not a parameter of this model", fo[i]) end;
    p = setfield(p, fo[i], getfield(over, fo[i]))
  ) end;
  p
)

% internal: the size of a residual — its largest entry, or inf if any entry
% is not a finite real number (so a search never steps there).
let dg_size = fn r -> if any(isnan(real(r))) || any(isinf(real(r))) || any(imag(r) != 0) then inf else max(abs(r)) end

% internal: smallest over largest singular value (0 for a singular matrix).
let dg_rcond = fn M -> (
  if any(isnan(M)) || any(isinf(M)) then return 0.0 end;
  let sv = svd(M).S;
  if max(sv) == 0 then 0.0 else min(sv) / max(sv) end
)

% internal: the steady state as a column — from the model's steady function
% if it has one (checked against the equations), else by damped Newton from
% init with the exact dual-number Jacobian.
let dg_ss = fn m, p -> (
  let n = m.n;
  let z = zeros(m.k, 1);
  let g = fn y -> m.f([y; y; y; z], p);
  if m.hassteady then (
    let y = dg_col(m.steadyfn(p), m.vars, 0.0 / 0.0, "steady");
    if any(isnan(y)) then error("dsge: the steady function must give a value for every variable") end;
    let nr = dg_size(g(y));
    if !(nr < 1e-8) then error("dsge: the steady function does not solve the model (largest residual {})", nr) end;
    return y
  ) end;
  let y = m.init;
  let r = g(y);
  let nr = dg_size(r);
  if nr == inf then error("dsge: the equations cannot be evaluated at the starting values — set init") end;
  let it = 0;
  while (nr > 1e-12) && (it < 200) do (
    let J = zeros(n, n);
    let v = [y; y; y; z];
    for i = 1 : n do (
      let seed = 0.0 * v;
      seed[i] = 1.0; seed[n + i] = 1.0; seed[2 * n + i] = 1.0;
      J[:, i] = dualeps(m.f(dual(v, seed), p))
    ) end;
    if dg_rcond(J) < 1e-13 then
      error("dsge: the steady state is not locally unique here (singular Jacobian) — try other init values, or supply it with a steady function in the model record")
    end;
    let d = -(J \ r);
    let t = 1.0;
    let yn = y + d; let rn = g(yn); let nn = dg_size(rn);
    while (!(nn < nr)) && (t > 1e-12) do (
      t = t / 2; yn = y + t * d; rn = g(yn); nn = dg_size(rn)
    ) end;
    if !(nn < nr) then (it = 200) else ( y = yn; r = rn; nr = nn; it = it + 1 ) end
  ) end;
  if !(nr < 1e-9) then
    error("dsge: no steady state found from these starting values (residual {}) — set init, or supply a steady function in the model record", nr)
  end;
  y
)

% internal: the exact Jacobians A (leads), B (current), C (lags), D (shocks)
% of the residual at the point y held in every period with no shocks — one
% dual pass per column — and the residual r there (zero if y is the model's
% own steady state; occbin linearises a second regime around the first's).
let dg_lin_at = fn m, p, y -> (
  let n = m.n; let k = m.k;
  let v = [y; y; y; zeros(k, 1)];
  let use = find([m.lead, ones(1, n), m.lag, ones(1, k)] > 0);
  let J = zeros(n, 3 * n + k);
  for c = 1 : numel(use) do (
    let j = use[c];
    let seed = 0.0 * v;
    seed[j] = 1.0;
    J[:, j] = dualeps(m.f(dual(v, seed), p))
  ) end;
  {y = y, A = J[:, 1 : n], B = J[:, n + 1 : 2 * n], C = J[:, 2 * n + 1 : 3 * n],
   D = J[:, 3 * n + 1 : 3 * n + k], r = m.f(v, p)}
)

% internal: steady state and the Jacobians of the residual there.
let dg_lin = fn m, p -> dg_lin_at(m, p, dg_ss(m, p))

% internal: cyclic reduction for A P^2 + B P + C = 0 — the solvent built
% from the n smallest roots. Returns {found, P}; found is false if a pivot
% matrix went singular, the iteration left the finite numbers, or the
% result does not satisfy the equation.
let dg_cr = fn A, B, C -> (
  let n = size(B)[1];
  let A0 = C; let A1 = B; let A2 = A; let Ah = B;
  let state = 0; let it = 0;
  while (state == 0) && (it < 60) do (
    if dg_rcond(A1) < 1e-14 then (state = 2)
    else (
      let K0 = A1 \ A0; let K2 = A1 \ A2;
      let dA = A2 * K0;
      A1 = A1 - A0 * K2 - dA;
      Ah = Ah - dA;
      let N0 = -(A0 * K0); let N2 = -(A2 * K2);
      A0 = N0; A2 = N2;
      it = it + 1;
      if dg_size(Ah) == inf then (state = 2)
      elseif max(abs(dA)) <= 1e-15 * max(1.0, max(abs(Ah))) then (state = 1)
      end
    ) end
  ) end;
  if (state != 1) || (dg_rcond(Ah) < 1e-14) then return {found = false, P = zeros(n, n)} end;
  let P = 0.0 - (Ah \ C);                  % 0.0 - x, not -x: no negative zeros
  let res = dg_size(A * P * P + B * P + C);
  {found = res <= 1e-8 * max(1.0, max(abs(B))), P = P}
)

% internal: the moduli of all 2n roots of lambda^2 A + lambda B + C, by a
% shift-and-invert eigenproblem on the companion pencil (infinite roots
% come out as inf). Used only when cyclic reduction finds no solvent.
let dg_roots = fn A, B, C -> (
  let n = size(B)[1];
  let Z = zeros(n, n); let I = eye(n);
  let M = [Z, I; -C, -B]; let N = [I, Z; Z, A];
  let shifts = [1.6180339887, -1.3247179572, 0.7390851332, 2.5029078750];
  let s = 0.0; let best = -1.0;
  for i = 1 : 4 do (
    let rc = dg_rcond(M - shifts[i] * N);
    if rc > best then ( best = rc; s = shifts[i] ) end
  ) end;
  if best < 1e-14 then error("dsge: the model is singular — some combination of its equations does not involve the variables at all") end;
  let th = eig((M - s * N) \ N).values;
  let tiny = abs(th) < 1e-12;
  sort(pick(tiny, inf, abs(s + 1 ./ pick(tiny, 1.0, th))))
)

% internal: solve the linearised model. Returns the decision rule if cyclic
% reduction finds one, the sorted moduli of all 2n roots, and how many are
% stable (unit roots count as stable, as in Dynare).
let dg_core = fn A, B, C -> (
  let n = size(B)[1];
  let cr = dg_cr(A, B, C);
  let roots = if cr.found then (
      let mu = abs(eig((A * cr.P + B) \ A).values);
      let zero = mu < 1e-12;
      sort([abs(eig(cr.P).values); pick(zero, inf, 1 ./ pick(zero, 1.0, mu))])
    ) else dg_roots(A, B, C) end;
  {found = cr.found, P = cr.P, roots = roots, nstable = sum(roots < 1 + 1e-6)}
)

% dsge.steady(m, over = {}): the steady state, as a record by variable name.
% It comes from the model's steady function if it has one, else Newton's method
% from init with exact derivatives. over is a record of parameter values to
% use instead of the model's own.
% e.g. format(6); dsge.steady(dsge.model(dsge.rbc())).k %= 28.3484
% e.g. format(6); dsge.steady(dsge.model(dsge.rbc()), {beta = 0.98}).k %= 19.3038
% e.g. dsge.steady(dsge.model(dsge.nk())).pi           %= 0
let dsge_steady = fn m, over = {} -> (
  let y = dg_ss(m, dg_params(m, over));
  let r = {};
  for i = 1 : m.n do r = setfield(r, m.vars[i], y[i]) end;
  r
)

% dsge.bk(m, over = {}): the Blanchard-Kahn check, as a value not an error.
% Returns a record {ok, verdict, unstable, forward, roots}. verdict is
% "determinate" (a unique stable solution), "indeterminate" (many: too few
% unstable roots) or "explosive" (none: too many); unstable roots are
% counted against the forward-looking variables as Dynare's check does,
% and roots are the moduli, sorted. Use it to map a determinacy region.
% e.g. dsge.bk(dsge.model(dsge.nk())).verdict          %= "determinate"
% e.g. dsge.bk(dsge.model(dsge.nk()), {phi_pi = 0.9}).verdict %= "indeterminate"
% e.g. let b = dsge.bk(dsge.model(dsge.rbc())); [b.unstable, b.forward] %= [2, 2]
let dsge_bk = fn m, over = {} -> (
  let p = dg_params(m, over);
  let L = dg_lin(m, p);
  let c = dg_core(L.A, L.B, L.C);
  let n = m.n;
  let nf = sum(m.lead > 0); let nb = sum(m.lag > 0);
  let verdict = if c.nstable == n then (if c.found then "determinate" else "unsolved" end)
                elseif c.nstable > n then "indeterminate" else "explosive" end;
  {ok = verdict == "determinate", verdict = verdict,
   unstable = 2 * n - c.nstable - (n - nf), forward = nf,
   roots = c.roots[n - nb + 1 : n + nf, 1]}
)

% dsge.solve(m, over = {}): steady state and first-order solution.
% Returns a record: ss (steady state by name), P and Q with y = P y(-1) + Q e in
% deviations from the steady state (rows and columns in the order of
% m.vars and m.shocks), roots (moduli, as dsge.bk gives them), sd, params and
% the model. An error explains which Blanchard-Kahn condition fails if the
% model has no unique stable solution. over overrides parameters.
% e.g. let s = dsge.solve(dsge.model(dsge.rbc())); format(6); s.P[4, 4] %= 0.962061
% e.g. let s = dsge.solve(dsge.model(dsge.rbc())); size(s.Q) %= [5, 1]
% e.g. let s = dsge.solve(dsge.model(dsge.nk())); format(6); s.Q[2, 2] %= -0.287729
let dsge_solve = fn m, over = {} -> (
  let p = dg_params(m, over);
  let L = dg_lin(m, p);
  let c = dg_core(L.A, L.B, L.C);
  let n = m.n;
  let nf = sum(m.lead > 0); let nb = sum(m.lag > 0);
  let unst = 2 * n - c.nstable - (n - nf);
  if c.nstable > n then
    error("dsge: indeterminacy — {} unstable root(s) for {} forward-looking variable(s); many stable paths", unst, nf)
  end;
  if c.nstable < n then
    error("dsge: no stable solution — {} unstable root(s) for {} forward-looking variable(s); every path explodes", unst, nf)
  end;
  if !c.found then error("dsge: the solver could not compute the decision rule for this model") end;
  let Q = 0.0 - ((L.A * c.P + L.B) \ L.D);
  let ss = {};
  for i = 1 : n do ss = setfield(ss, m.vars[i], L.y[i]) end;
  {model = m, params = p, ss = ss, ybar = L.y, P = c.P, Q = Q,
   roots = c.roots[n - nb + 1 : n + nf, 1], sd = m.sd}
)

% internal: the position of a shock given by name.
let dg_shock = fn s, name -> (
  let j = dg_find(s.model.shocks, name);
  if j == 0 then error("dsge: '{}' is not a shock of this model (the shocks are {})", name, strjoin(s.model.shocks, ", ")) end;
  j
)

% dsge.irf(s, shock, T = 40): impulse responses to one named shock.
% The innovation is one standard deviation. Returns a record of columns,
% one per variable, T periods long, row 1 being the period of the shock.
% Values are deviations from the steady state.
% e.g. let r = dsge.irf(dsge.solve(dsge.model(dsge.rbc())), "e", 20); format(6); r.a[1] %= 0.0100000
% e.g. let r = dsge.irf(dsge.solve(dsge.model(dsge.rbc())), "e", 20); format(6); r.a[2] %= 0.00950000
% e.g. length(dsge.irf(dsge.solve(dsge.model(dsge.nk())), "ev").pi) %= 40
let dsge_irf = fn s, shock, T = 40 -> (
  let j = dg_shock(s, shock);
  let n = s.model.n;
  let Y = zeros(T, n);
  let y = s.Q[:, j] * s.sd[j];
  for t = 1 : T do ( Y[t, :] = y'; y = s.P * y ) end;
  dg_table(Y, s.model.vars)
)

% dsge.simulate(s, T = 200): a simulated path of T periods, in levels.
% It starts from the steady state, with shocks drawn from the session's
% generator (rng to reproduce). Returns a record of columns, one per
% variable, in LEVELS rather than deviations.
% e.g. rng(1); length(dsge.simulate(dsge.solve(dsge.model(dsge.rbc())), 50).c) %= 50
% e.g. rng(1); let x = dsge.simulate(dsge.solve(dsge.model(dsge.rbc())), 50); max(abs(x.y - x.c - x.i)) < 1e-12 %= true
let dsge_simulate = fn s, T = 200 -> (
  let n = s.model.n; let k = s.model.k;
  let Y = zeros(T, n);
  let y = zeros(n, 1);
  for t = 1 : T do (
    y = s.P * y + s.Q * (s.sd .* randn(k, 1));
    Y[t, :] = (s.ybar + y)'
  ) end;
  dg_table(Y, s.model.vars)
)

% internal: the unconditional covariance of y = P y(-1) + w, var(w) = W,
% by doubling (S = W + P W P' + P^2 W P^2' + ...).
let dg_lyap = fn P, W -> (
  if max(abs(eig(P).values)) > 1 - 1e-9 then
    error("dsge: the model has a unit root, so its variables have no unconditional variance")
  end;
  let S = W; let M = P; let it = 0; let moving = true;
  while moving && (it < 200) do (
    let dS = M * S * M';
    S = S + dS;
    M = M * M;
    it = it + 1;
    moving = max(abs(dS)) > 1e-15 * max(1e-300, max(abs(S)))
  ) end;
  (S + S') / 2
)

% dsge.moments(s, K = 5): theoretical moments of the solved model.
% Returns a record {vars, mean, sd, var, corr, acorr}: steady-state
% means, standard deviations, the covariance and correlation matrices, and
% autocorrelations at lags 1..K (one row per variable). A variable that
% never moves has nan correlations.
% e.g. let q = dsge.moments(dsge.solve(dsge.model(dsge.rbc()))); format(4); q.sd[5] %= 0.03203
% e.g. let q = dsge.moments(dsge.solve(dsge.model(dsge.rbc()))); format(4); q.acorr[5, 1] %= 0.9500
% e.g. let q = dsge.moments(dsge.solve(dsge.model(dsge.rbc()))); format(4); q.corr[1, 2] %= 0.9308
let dsge_moments = fn s, K = 5 -> (
  let n = s.model.n;
  let QS = s.Q .* (ones(n, 1) * s.sd');
  let S = dg_lyap(s.P, QS * QS');
  let d = diag(S);
  let sdv = sqrt(max(d, 0.0));
  let den = sdv * sdv';
  let ac = zeros(n, K);
  let G = S;
  for j = 1 : K do ( G = s.P * G; ac[:, j] = diag(G) ./ d ) end;
  {vars = s.model.vars, mean = s.ybar, sd = sdv, var = S, corr = S ./ den, acorr = ac}
)

% dsge.vardecomp(s): the unconditional variance decomposition, in percent.
% One row per variable (in the order of the model's vars), one column per
% shock; each row sums to 100.
% e.g. dsge.vardecomp(dsge.solve(dsge.model(dsge.rbc())))[1, 1] %= 100
% e.g. let v = dsge.vardecomp(dsge.solve(dsge.model(dsge.nk()))); format(4); sum(v[1, :]) %= 100.0
% e.g. let v = dsge.vardecomp(dsge.solve(dsge.model(dsge.nk()))); format(4); v[2, 1] %= 98.70
let dsge_vardecomp = fn s -> (
  let n = s.model.n; let k = s.model.k;
  let V = zeros(n, k);
  for j = 1 : k do (
    let q = s.Q[:, j] * s.sd[j];
    V[:, j] = diag(dg_lyap(s.P, q * q'))
  ) end;
  100 * V ./ (sum(V, 2) * ones(1, k))
)

% ---- second order -------------------------------------------------------
% The solution to second order in the states x (the variables that appear
% with a lag, as they stood last period, in deviation from the steady
% state) and the shocks e:
%
%   y = ybar + P y(-1) + Q e
%            + 1/2 [ Gxx (x (x) x) + 2 Gxu (x (x) e) + Guu (e (x) e) + s2 ]
%
% (x) is the Kronecker product, so entry (a - 1) nx + b of x (x) x is
% x[a] x[b]. Gxx, Gxu and Guu are the second derivatives of the decision
% rule and s2 is the effect of risk: with shocks still to come, the point
% the economy settles at is not the steady state of the equations.
%
% How it is computed. Differentiating the model twice along the solution
% gives, with M = A P + B and x restricted to the states,
%
%   M Gxx + A Gxx (Pxx (x) Pxx) = -Rxx
%
% and Gxu, Guu and s2 then follow from one linear solve each. R is the
% Hessian of the equations applied to pairs of first-order directions; it
% is never formed as a Hessian. Each column is one pass of the equations
% on hyper-dual numbers seeded with two directions, which returns the
% exact mixed second derivative along them: (nx + k)(nx + k + 1) / 2
% passes, and no differencing. The equation for Gxx is a generalized
% Sylvester equation in n nx^2 unknowns; it is solved on the complex Schur
% forms of M \ A and Pxx, where it falls apart into nx^2 triangular
% systems of order n taken in turn.

% internal: for every equation, the second derivative of its residual at v
% along the directions d1 and d2 (d1' H d2, H the equation's Hessian).
let dg_d2 = fn m, p, v, d1, d2 -> hdual12(m.f(hdual(v, d1, d2), p))

% internal: c * kron(V, V) for every row c of C, without forming the
% Kronecker product: a row read as a q x q matrix Z becomes V.' Z V.
let dg_rowkron = fn C, V -> (
  let q = size(V)[1]; let out = C;
  let Vt = V.';
  for i = 1 : size(C)[1] do out[i, :] = reshape(Vt * reshape(C[i, :], q, q) * V, 1, q * q) end;
  out
)

% internal: the X that solves X + K X (S (x) S) = C, for K n x n, S q x q and
% C n x q^2. With K = U T U' and S = V R V' (complex Schur forms) and
% Y = U' X (V (x) V) it reads Y + T Y (R (x) R) = U' C (V (x) V); R (x) R is
% upper triangular, so the columns of Y come one after another, each from
% a triangular system (I + R[a,a] R[b,b] T) y = c - T (Y times a column of
% R (x) R, which involves only columns already found).
let dg_sylv2 = fn K, S, C -> (
  let n = size(K)[1]; let q = size(S)[1];
  if q == 0 then return zeros(n, 0) end;
  let sk = schur(K, "complex"); let ss = schur(S, "complex");
  let T = sk.T; let R = ss.T;
  let Ct = dg_rowkron(sk.U' * C, ss.U);
  let Y = 0.0 * Ct;
  let I = eye(n);
  for a = 1 : q do for b = 1 : q do (
    let j = (a - 1) * q + b;
    let lhs = I + (R[a, a] * R[b, b]) * T;
    if dg_rcond(lhs) < 1e-13 then
      error("dsge: the second-order solution does not exist here — a product of two stable roots meets an unstable one (a resonance)")
    end;
    Y[:, j] = lhs \ (Ct[:, j] - T * (Y * kron(R[:, a], R[:, b])))
  ) end end;
  let X = sk.U * dg_rowkron(Y, ss.U');
  if max(abs(imag(X))) > 1e-8 * max(1.0, max(abs(real(X)))) then
    error("dsge: the second-order coefficients came out complex — the Schur forms were not accurate enough")
  end;
  real(X)
)

% dsge.solve2(m, over = {}): the solution to second order.
% Returns what dsge.solve returns — ss, ybar, P, Q, roots, sd, params, model —
% and the second-order terms of the decision rule
%   y = ybar + P y(-1) + Q e + 1/2 [Gxx (x (x) x) + 2 Gxu (x (x) e) + Guu (e (x) e) + s2]
% where x holds the state variables (those that appear with a lag) as they
% were last period, in deviation from the steady state, and (x) is the
% Kronecker product: Gxx (n by nx^2), Gxu (n by nx k), Guu (n by k^2), s2 (n
% by 1, the correction for risk, which scales with the shocks' variances),
% states (the names of the state variables, in the order of x) and order =
% 2. The derivatives are exact (hyper-dual numbers). Use dsge.simulate2,
% dsge.irf2 and dsge.mean2 on the result; dsge.irf, dsge.moments and the
% rest read its first-order part.
% e.g. let s = dsge.solve2(dsge.model(dsge.rbc())); [size(s.Gxx), size(s.Gxu), size(s.Guu)] %= [5, 4, 5, 2, 5, 1]
% e.g. let s = dsge.solve2(dsge.model(dsge.rbc())); s.states %= ["k", "a"]
% e.g. let s = dsge.solve2(dsge.model(dsge.rbc())); format(6); s.Guu[2, 1] %= 0.490011
% e.g. let s = dsge.solve2(dsge.model(dsge.rbc())); format(6); s.s2[4] %= 3.85224e-05
% e.g. let s = dsge.solve2(dsge.model(dsge.nk())); max(abs([s.Gxx[:]; s.Gxu[:]; s.Guu[:]; s.s2])) %= 0
let dsge_solve2 = fn m, over = {} -> (
  let s = dsge_solve(m, over);
  let p = s.params; let n = m.n; let k = m.k;
  let L = dg_lin_at(m, p, s.ybar);
  let P = s.P; let Q = s.Q;
  let st = find(m.lag > 0); let nx = numel(st);
  let Px = P[:, st]; let Pxx = P[st, st]; let Qx = Q[st, :];
  let M = L.A * P + L.B;
  % how [y(+1); y; y(-1); e] moves, to first order, with z = [x; e]
  let G1 = [Px, Q];
  let back = zeros(n, nx + k);
  for a = 1 : nx do back[st[a], a] = 1.0 end;
  let V1 = [Px * G1[st, :]; G1; back; zeros(k, nx), eye(k)];
  let v = [s.ybar; s.ybar; s.ybar; zeros(k, 1)];
  let Rxx = zeros(n, nx * nx); let Rxu = zeros(n, nx * k); let Ruu = zeros(n, k * k);
  for a = 1 : nx + k do for b = a : nx + k do (
    let r = dg_d2(m, p, v, V1[:, a], V1[:, b]);
    if b <= nx then ( Rxx[:, (a - 1) * nx + b] = r; Rxx[:, (b - 1) * nx + a] = r )
    elseif a <= nx then ( Rxu[:, (a - 1) * k + b - nx] = r )
    else ( Ruu[:, (a - nx - 1) * k + b - nx] = r; Ruu[:, (b - nx - 1) * k + a - nx] = r ) end
  ) end end;
  if dg_size([Rxx[:]; Rxu[:]; Ruu[:]]) == inf then
    error("dsge: the equations have no finite second derivatives at the steady state")
  end;
  let Gxx = dg_sylv2(M \ L.A, Pxx, 0.0 - (M \ Rxx));
  % a second derivative does not depend on the order of its two arguments;
  % the solve leaves that true to rounding, and this makes it exact
  for a = 1 : nx do for b = a + 1 : nx do (
    let g = 0.5 * (Gxx[:, (a - 1) * nx + b] + Gxx[:, (b - 1) * nx + a]);
    Gxx[:, (a - 1) * nx + b] = g; Gxx[:, (b - 1) * nx + a] = g
  ) end end;
  let Gxu = 0.0 - (M \ (Rxu + L.A * Gxx * kron(Pxx, Qx)));
  let Guu = 0.0 - (M \ (Ruu + L.A * Gxx * kron(Qx, Qx)));
  % risk: tomorrow's shocks have variance sd^2, and the equations are curved
  let rhs = zeros(n, 1);
  for j = 1 : k do (
    let d = [Q[:, j]; zeros(2 * n + k, 1)];
    rhs = rhs + (s.sd[j]^2) * (L.A * Guu[:, (j - 1) * k + j] + dg_d2(m, p, v, d, d))
  ) end;
  let s2 = 0.0 - ((L.A * P + L.A + L.B) \ rhs);
  let clean = fn X -> pick(abs(X) < 1e-13 * max(1e-300, max(abs(X))), 0.0, X);
  {model = m, params = p, ss = s.ss, ybar = s.ybar, P = P, Q = Q, roots = s.roots, sd = s.sd,
   order = 2, states = m.vars[st], Gxx = clean(Gxx), Gxu = clean(Gxu), Guu = clean(Guu), s2 = clean(s2)}
)

% internal: a second-order solution or an error that says what was given.
let dg_need2 = fn s, who -> (
  if dg_find(fields(s), "Gxx") == 0 then
    error("dsge: {} needs a second-order solution — use dsge.solve2(m), not dsge.solve(m)", who)
  end;
  true
)

% internal: the pruned path of a second-order solution for the shocks in E
% (T by k, one row per period), from the steady state. Pruning (Kim, Kim,
% Schaumburg and Sims) keeps a first-order state and a second-order
% correction apart, and squares only the first: the path cannot explode
% the way iterating the quadratic rule itself can. Returns {Y1, Y2}, the
% two parts as T by n deviations; the path is ybar + Y1 + Y2.
let dg_path2 = fn s, E -> (
  let n = s.model.n; let T = size(E)[1];
  let st = find(s.model.lag > 0);
  let Y1 = zeros(T, n); let Y2 = zeros(T, n);
  let y1 = zeros(n, 1); let y2 = zeros(n, 1);
  for t = 1 : T do (
    let e = E[t, :]';
    let x = y1[st, 1];
    y2 = s.P * y2 + 0.5 * (s.Gxx * kron(x, x) + 2.0 * (s.Gxu * kron(x, e)) + s.Guu * kron(e, e) + s.s2);
    y1 = s.P * y1 + s.Q * e;
    Y1[t, :] = y1'; Y2[t, :] = y2'
  ) end;
  {Y1 = Y1, Y2 = Y2}
)

% dsge.simulate2(s, T = 200): a simulated path of a second-order solution, in levels.
% Like dsge.simulate — from the steady state, shocks from the session's
% generator, a record of columns by variable — but with the second-order
% terms, simulated with pruning so that the path stays bounded.
% e.g. rng(1); let s = dsge.solve2(dsge.model(dsge.rbc())); length(dsge.simulate2(s, 50).c) %= 50
% e.g. rng(1); let s = dsge.solve2(dsge.model(dsge.rbc())); let a = dsge.simulate2(s, 30); rng(1); let b = dsge.simulate(s, 30); max(abs(a.a - b.a)) %= 0
let dsge_simulate2 = fn s, T = 200 -> (
  dg_need2(s, "simulate2");
  let k = s.model.k;
  let E = zeros(T, k);
  for t = 1 : T do E[t, :] = (s.sd .* randn(k, 1))' end;
  let r = dg_path2(s, E);
  dg_table(r.Y1 + r.Y2 + ones(T, 1) * s.ybar', s.model.vars)
)

% dsge.irf2(s, shock, T = 40, size = 1): impulse responses to second order.
% The effect of one innovation of size standard deviations (negative for a
% shock the other way) on a path that starts at the steady state and has no
% other shocks, as deviations: a record of columns like dsge.irf's. To first
% order a response scales with the shock; here twice the shock is not twice
% the response, and a negative shock is not the mirror image of a positive
% one.
% e.g. let s = dsge.solve2(dsge.model(dsge.rbc())); length(dsge.irf2(s, "e").c) %= 40
% e.g. let s = dsge.solve2(dsge.model(dsge.rbc())); let r = dsge.irf2(s, "e", 20); let q = dsge.irf(s, "e", 20); max(abs(r.a - q.a)) < 1e-15 %= true
% e.g. let s = dsge.solve2(dsge.model(dsge.rbc())); let up = dsge.irf2(s, "e", 20, 3); let dn = dsge.irf2(s, "e", 20, -3); up.c[1] + dn.c[1] > 0 %= true
let dsge_irf2 = fn s, shock, T = 40, size = 1 -> (
  dg_need2(s, "irf2");
  let j = dg_shock(s, shock);
  let k = s.model.k;
  let E = zeros(T, k); let E0 = zeros(T, k);
  E[1, j] = size * s.sd[j];
  let a = dg_path2(s, E); let b = dg_path2(s, E0);
  dg_table(a.Y1 + a.Y2 - b.Y2, s.model.vars)
)

% dsge.mean2(s): the unconditional means to second order, by variable name.
% To first order a variable's mean is its steady state. To second order it
% is not: risk shifts the decision rule (s2) and the rule's curvature turns
% the variance of the states and shocks into a change in the mean. Needs a
% stationary model.
% e.g. let s = dsge.solve2(dsge.model(dsge.rbc())); format(6); dsge.mean2(s).k %= 28.3955
% e.g. let s = dsge.solve2(dsge.model(dsge.rbc())); dsge.mean2(s).k > s.ss.k %= true
% e.g. let s = dsge.solve2(dsge.model(dsge.nk())); dsge.mean2(s).pi %= 0
let dsge_mean2 = fn s -> (
  dg_need2(s, "mean2");
  let n = s.model.n; let k = s.model.k;
  let st = find(s.model.lag > 0);
  let QS = s.Q .* (ones(n, 1) * s.sd');
  let Sy = dg_lyap(s.P, QS * QS');
  let Sx = Sy[st, st];
  let vu = zeros(k * k, 1);
  for j = 1 : k do vu[(j - 1) * k + j] = s.sd[j]^2 end;
  let nx = numel(st);
  let drift = 0.5 * (s.Gxx * reshape(Sx, nx * nx, 1) + s.Guu * vu + s.s2);
  let mu = s.ybar + (eye(n) - s.P) \ drift;
  let r = {};
  for i = 1 : n do r = setfield(r, s.model.vars[i], mu[i]) end;
  r
)

% internal: the parameters of m with those entries of over that m has (the
% two regimes of occbin share most parameters, and each may have its own).
let dg_params_shared = fn m, over -> (
  let p = m.params;
  let fo = fields(over);
  for i = 1 : numel(fo) do
    if dg_find(m.pnames, fo[i]) > 0 then (p = setfield(p, fo[i], getfield(over, fo[i]))) end
  end;
  p
)

% internal: the shocks of an occbin run as a T x k matrix, from a matrix
% (one column per shock, in the model's order) or a record of columns by
% shock name (shocks not named are zero).
let dg_shockpath = fn m, e -> (
  let k = m.k;
  if numel(fields(e)) == 0 then error("dsge: occbin needs shocks — a matrix with one column per shock, or a record of columns by shock name") end;
  let fe = fields(e); let T = 0;
  for i = 1 : numel(fe) do (
    if dg_find(m.shocks, fe[i]) == 0 then error("dsge: '{}' is not a shock of this model (the shocks are {})", fe[i], strjoin(m.shocks, ", ")) end;
    T = max(T, numel(getfield(e, fe[i])))
  ) end;
  let E = zeros(T, k);
  for i = 1 : numel(fe) do (
    let col = getfield(e, fe[i]);
    let j = dg_find(m.shocks, fe[i]);
    for t = 1 : numel(col) do E[t, j] = col[t] end
  ) end;
  E
)

% dsge.occbin(ref, alt, opts): a model with one occasionally binding constraint.
% The piecewise-linear method of Guerrieri and Iacoviello (2015), OccBin.
% ref is the model while the constraint is slack and alt the model while
% it binds: the same variables and shocks, one or more equations different
% (a policy rule replaced by the bound, a multiplier set free). Both are
% linearised at ref's steady state. opts is a record:
%   shocks  the innovations, period by period: a record of columns by shock
%           name ({en = [-3; -1]}; shocks not named are zero), in the
%           shocks' own units. Each one is a surprise: agents expect none
%           after it.
%   bind    fn v -> logical column: where, on a path computed with the
%           constraint slack, it is violated (v is a record of columns, one
%           per variable, in LEVELS, like the result of dsge.simulate).
%   relax   fn v -> logical column: where, on a path computed with it
%           binding, it would no longer bind. Default: where bind is false.
%   T       periods to simulate (default: the length of shocks).
%   horizon periods ahead agents are followed until the constraint is slack
%           for good (default 100); an error if it still binds there.
%   maxit   regime guesses tried per period (default 50).
%   over    parameter values to use instead of the models' own; a name is
%           applied to each model that has it.
% Returns a record: path and linear (records of columns in levels — with
% the constraint, and ignoring it), binding (a logical column: the periods
% in which it binds), and iterations (the regime guesses needed, by period).
% e.g. let z = dsge.zlb(); let r = dsge.occbin(z.ref, z.alt, {shocks = {en = [-3.0]}, bind = z.bind, T = 12}); sum(r.binding) %= 7
% e.g. let z = dsge.zlb(); let r = dsge.occbin(z.ref, z.alt, {shocks = {en = [-3.0]}, bind = z.bind, T = 12}); min(r.path.i) %= -1
% e.g. let z = dsge.zlb(); let r = dsge.occbin(z.ref, z.alt, {shocks = {en = [-3.0]}, bind = z.bind, T = 12}); r.path.x[1] < r.linear.x[1] %= true
% e.g. let z = dsge.zlb(); let r = dsge.occbin(z.ref, z.alt, {shocks = {en = [0.5]}, bind = z.bind, T = 8}); [any(r.binding), max(abs(r.path.x - r.linear.x)) < 1e-12] %= [false, true]
let dsge_occbin = fn ref, alt, opts -> (
  let known = ["shocks", "bind", "relax", "T", "horizon", "maxit", "over"];
  let fo = fields(opts);
  for i = 1 : numel(fo) do
    if dg_find(known, fo[i]) == 0 then
      error("dsge: occbin has no option '{}' (the options are shocks, bind, relax, T, horizon, maxit, over)", fo[i])
    end
  end;
  if dg_find(fo, "bind") == 0 then error("dsge: occbin needs bind, a function of the path that says where the constraint is violated") end;
  if dg_find(fo, "shocks") == 0 then error("dsge: occbin needs shocks — a record of columns by shock name") end;
  let n = ref.n; let k = ref.k;
  if (alt.n != n) || (alt.k != k) || (strjoin(alt.vars, " ") != strjoin(ref.vars, " ")) || (strjoin(alt.shocks, " ") != strjoin(ref.shocks, " ")) then
    error("dsge: the two regimes of occbin must have the same variables and shocks, in the same order")
  end;
  let over = if dg_find(fo, "over") > 0 then opts.over else {} end;
  let bind = opts.bind;
  let hasrelax = dg_find(fo, "relax") > 0;
  let relax = if hasrelax then opts.relax else bind end;
  let E = dg_shockpath(ref, opts.shocks);
  let T = if dg_find(fo, "T") > 0 then opts.T else size(E)[1] end;
  let H = if dg_find(fo, "horizon") > 0 then opts.horizon else 100 end;
  let maxit = if dg_find(fo, "maxit") > 0 then opts.maxit else 50 end;
  if T < size(E)[1] then error("dsge: occbin was given {} periods of shocks but T = {}", size(E)[1], T) end;

  % the two linear systems, both around the reference steady state:
  %   A x(+1) + B x + C x(-1) + D e + r = 0   (r = 0 in the reference regime)
  let L1 = dg_lin(ref, dg_params_shared(ref, over));
  let ybar = L1.y;
  let L2 = dg_lin_at(alt, dg_params_shared(alt, over), ybar);
  if dg_size(L2.r) == inf then error("dsge: the binding regime's equations cannot be evaluated at the reference steady state") end;
  let c = dg_core(L1.A, L1.B, L1.C);
  if (c.nstable != n) || !c.found then
    error("dsge: occbin needs a reference regime with a unique stable solution (Blanchard-Kahn fails there)")
  end;
  let P = c.P;
  let Q = 0.0 - ((L1.A * P + L1.B) \ L1.D);
  let r1 = zeros(n, 1);

  let levels = fn X -> dg_table(X + ones(size(X)[1], 1) * ybar', ref.vars);
  let X = zeros(T, n); let Xlin = zeros(T, n);
  let bound = zeros(T, 1); let iters = zeros(T, 1);
  let x = zeros(n, 1); let xl = zeros(n, 1);
  let g = zeros(H, 1);                                 % the guess: 1 for each period ahead in which it binds
  for t = 1 : T do (
    let e = if t <= size(E)[1] then E[t, :]' else zeros(k, 1) end;
    xl = P * xl + Q * e;
    Xlin[t, :] = xl';
    let settled = false; let it = 0; let path = zeros(H, n);
    while !settled do (
      it = it + 1;
      if it > maxit then
        error("dsge: occbin could not settle which periods bind (period {}, {} guesses) — the guesses may be cycling", t, maxit)
      end;
      let last = 0;
      for s = 1 : H do if g[s] > 0.5 then (last = s) end end;
      if last == H then
        error("dsge: the constraint still binds {} periods ahead (period {}) — lengthen horizon, or the shock is too large for the model to leave the constraint", H, t)
      end;
      % decision rules backward from the last binding period: x(s) = Ps x(s-1) + ds
      let Ps = zeros(max(last, 1) * n, n); let ds = zeros(n, max(last, 1));
      let Pn = P; let dn = zeros(n, 1); let Q1 = Q;
      for back = 1 : last do (
        let s = last + 1 - back;
        let Ls = if g[s] > 0.5 then L2 else L1 end;
        let rs = if g[s] > 0.5 then L2.r else r1 end;
        let M = Ls.A * Pn + Ls.B;
        if dg_rcond(M) < 1e-13 then
          error("dsge: occbin met a singular system {} periods ahead (period {}): the binding regime does not pin the variables down", s, t)
        end;
        dn = 0.0 - (M \ (Ls.A * dn + rs));
        Pn = 0.0 - (M \ Ls.C);
        Ps[(s - 1) * n + 1 : s * n, :] = Pn;
        ds[:, s] = dn;
        if s == 1 then (Q1 = 0.0 - (M \ Ls.D)) end
      ) end;
      % the path those rules imply
      let z = x;
      for s = 1 : H do (
        if s <= last then (
          z = Ps[(s - 1) * n + 1 : s * n, :] * z + ds[:, s];
          if s == 1 then (z = z + Q1 * e) end
        ) else (
          z = P * z;
          if s == 1 then (z = z + Q * e) end
        ) end;
        path[s, :] = z'
      ) end;
      % does the path agree with the guess?
      let v = levels(path);
      let viol = bind(v);
      let free = if hasrelax then relax(v) else !viol end;
      let gn = g;
      for s = 1 : H do gn[s] = if (if g[s] > 0.5 then !free[s] else viol[s] end) then 1.0 else 0.0 end end;
      settled = max(abs(gn - g)) == 0;
      g = gn
    ) end;
    x = path[1, :]';
    X[t, :] = x';
    bound[t] = g[1];
    iters[t] = it;
    for s = 1 : H - 1 do g[s] = g[s + 1] end;          % next period starts from this one's guess
    g[H] = 0.0
  ) end;
  {path = levels(X), linear = levels(Xlin), binding = bound > 0.5, iterations = iters}
)

% dsge.zlb(): the New Keynesian model with a floor on the interest rate.
% A ready-made pair of regimes for dsge.occbin: the three-equation model of
% dsge.nk with a demand disturbance, where the central bank follows its rule
% (the notional rate inot) unless that would take the rate below -ibar —
% the steady-state rate with its sign changed, so the floor is a nominal
% rate of zero. Returns {ref, alt, bind}: the model with the rule in force,
% the model with the rate at the floor, and the test for the floor.
% e.g. dsge.zlb().ref.vars                     %= ["x", "pi", "i", "inot", "rn"]
% e.g. dsge.bk(dsge.zlb().ref).verdict         %= "determinate"
let dsge_zlb = fn -> (
  let par = {beta = 0.99, sigma = 1.0, kappa = 0.1275, phi_pi = 1.5, phi_x = 0.125,
             rho_n = 0.8, ibar = 1.0};
  let zero = {x = 0.0, pi = 0.0, i = 0.0, inot = 0.0, rn = 0.0};
  let common = ["pi = beta * pi(+1) + kappa * x";
                "x = x(+1) - (1 / sigma) * (i - pi(+1) - rn)";
                "inot = phi_pi * pi + phi_x * x";
                "rn = rho_n * rn(-1) + en"];
  let spec = fn rule -> {vars = "x pi i inot rn", shocks = "en", params = par, init = zero,
                         model = [common; rule]};
  {ref = dsge_model(spec("i = inot")),
   alt = dsge_model(spec("i = -ibar")),
   bind = fn v -> v.inot < -1.0}
)

% dsge.rbc(): the stochastic growth model, a ready-made spec.
% Variables are output y, consumption c, investment i, capital k and log
% technology a, with one technology shock e; quarterly calibration, CRRA
% utility. Its steady state is found by Newton's method from the init
% values.
% e.g. dsge.rbc().vars                      %= "y c i k a"
% e.g. numel(dsge.rbc().model)              %= 5
let dsge_rbc = fn -> {
  vars = "y c i k a",
  shocks = "e",
  params = {alpha = 0.33, beta = 0.99, delta = 0.025, rho = 0.95, sigma = 1.0},
  sd = {e = 0.01},
  init = {y = 3.0, c = 2.0, i = 1.0, k = 30.0, a = 0.0},
  model = ["c^(-sigma) = beta * c(+1)^(-sigma) * (alpha * exp(a(+1)) * k^(alpha - 1) + 1 - delta)";
           "y = exp(a) * k(-1)^alpha";
           "k = (1 - delta) * k(-1) + i";
           "y = c + i";
           "a = rho * a(-1) + e"]
}

% dsge.nk(): the three-equation New Keynesian model, a ready-made spec.
% From Gali (2015, ch. 3): output gap x, inflation pi, the policy rate i, and
% two AR(1) disturbances: the natural rate rn (shock en) and a monetary
% policy disturbance v (shock ev). Determinate exactly when
% kappa (phi_pi - 1) + (1 - beta) phi_x > 0, the Taylor principle.
% e.g. dsge.nk().shocks                     %= "en ev"
% e.g. dsge.nk().params.phi_pi              %= 1.5
let dsge_nk = fn -> {
  vars = "x pi i rn v",
  shocks = "en ev",
  params = {beta = 0.99, sigma = 1.0, kappa = 0.1275, phi_pi = 1.5, phi_x = 0.125,
            rho_n = 0.9, rho_v = 0.5},
  sd = {en = 0.25, ev = 0.25},
  init = {x = 0.0, pi = 0.0, i = 0.0, rn = 0.0, v = 0.0},
  model = ["pi = beta * pi(+1) + kappa * x";
           "x = x(+1) - (1 / sigma) * (i - pi(+1) - rn)";
           "i = phi_pi * pi + phi_x * x + v";
           "rn = rho_n * rn(-1) + en";
           "v = rho_v * v(-1) + ev"]
}

let dsge = {model = dsge_model, steady = dsge_steady, bk = dsge_bk, solve = dsge_solve,
            irf = dsge_irf, simulate = dsge_simulate, moments = dsge_moments,
            vardecomp = dsge_vardecomp, occbin = dsge_occbin,
            solve2 = dsge_solve2, simulate2 = dsge_simulate2, irf2 = dsge_irf2, mean2 = dsge_mean2,
            rbc = dsge_rbc, nk = dsge_nk, zlb = dsge_zlb}
