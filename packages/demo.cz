    dshow("let make_ssr = fn x, y -> fn b -> sum((y - b[1] * exp(b[2] * x)) .* (y - b[1] * exp(b[2] * x)))");
    dshow("minimize(make_ssr(x, y), [1.0; -0.1]).x");
    null) end;
  if s2 == 15 & k2 == 5 then (dhead("15.5 — Life-cycle consumption: the Euler equation falls out");
    dshow("load(\"packages/optim.cz\")");
    dshow("let T = 5; let β = 0.96; let R = 1.04; let W = 100.0");
    dshow("let U = fn c -> sum[t = 1:T] β^(t - 1) * log(c[t])");
    dshow("let sol = maximize_con(U, W / T * ones(T, 1), {eq = fn c -> [(sum[t = 1:T] c[t] / R^(t - 1)) - W]});");
    dshow("sol.x");
    dshow("abs(sol.x[2] / sol.x[1] - β * R) < 1e-4");
    dshow("abs((sum[t = 1:T] sol.x[t] / R^(t - 1)) - W) < 1e-9");
    null) end;
  if s2 == 15 & k2 == 6 then (dhead("15.6 — Minimum variance, numerically and in closed form");
    dshow("load(\"packages/optim.cz\")");
    dshow("let Σ = [0.04, 0.006, 0.0; 0.006, 0.09, 0.012; 0.0, 0.012, 0.16]");
    dshow("let vol2 = fn w -> sum(w .* (Σ * w))");
    dshow("let sol = minimize_con(vol2, ones(3, 1) / 3, {eq = fn w -> [sum(w) - 1]});");
    dshow("sol.x");
    dshow("let wstar = (Σ \\ ones(3, 1)) / sum(Σ \\ ones(3, 1));");
    dshow("max(abs(sol.x - wstar)) < 1e-5");
    dshow("sqrt(vol2(sol.x))");
    null) end;
  if s2 == 15 & k2 == 7 then (dhead("15.7 — GMM from generated data: two steps and a J test");
    dshow("load(\"packages/optim.cz\"); rng(7)");
    dshow("let n = 400; let z1 = randn(n, 1); let z2 = randn(n, 1); let Z = [z1, z2]");
    dshow("let v = randn(n, 1); let x = z1 + 0.5 * z2 + v; let y = 1.5 * x + 0.7 * v + 0.3 * randn(n, 1)");
    dshow("let g = fn b -> Z' * (y - x * b) / n");
    dshow("let β1 = minimize(fn b -> sum(g(b[1]) .* g(b[1])), [0.0]).x[1]; β1");
    dshow("let e = y - x * β1; let M = Z .* (e * ones(1, 2)); let Si = inv(M' * M / n);");
    dshow("let fit = minimize(fn b -> sum(g(b[1]) .* (Si * g(b[1]))), [β1]);");
    dshow("fit.x[1]");
    dshow("n * fit.fx");
    null) end;
  if s2 == 15 & k2 == 8 then (dhead("15.8 — Taylor by quotation: the language reads its own sin");
    dshow("load(\"packages/symb.cz\")");
    dshow("let f = ast(fn x -> sin(x)).body");
    dshow("let dtree = fn e, k -> if k == 0 then e else dtree(ddx(e), k - 1) end");
    dshow("let x = 0.0;");
    dshow("let c = (0:7) ~> (fn k -> eval(show(simp(dtree(f, k)))) / gamma(k + 1)); c");
    dshow("let Tn = fn m, u -> sum[k = 0:m] c[k + 1] * u^k");
    dshow("abs(Tn(7, 1.0) - sin(1.0)) < 3e-5");
    dshow("let xs = -pi:0.1:pi;");
    dshow("plot(xs, [xs ~> sin; xs ~> (fn u -> Tn(1, u)); xs ~> (fn u -> Tn(3, u)); xs ~> (fn u -> Tn(7, u))]', {title = \"sin and its Taylor truncations\", label1 = \"sin\", label2 = \"T1\", label3 = \"T3\", label4 = \"T7\"})");
    null) end;
  if s2 == 15 & k2 == 9 then (dhead("15.9 — Probit by Newton: exact scores, exact information");
    dshow("load(\"packages/optim.cz\"); load(\"packages/dist.cz\"); rng(12)");
    dshow("let n = 600; let βtrue = [0.5; -1.0]");
    dshow("let X = [ones(n, 1), randn(n, 1)]");
    dshow("let ε = randn(n, 1); let y = pick(X * βtrue + ε > 0, 1.0, 0.0);");
    dshow("let Φ = dist_Phi");
    dshow("let ℓ = fn b -> sum[i = 1:n] (let p = Φ((X[i, :] * b)[1, 1]); y[i] * log(p) + (1 - y[i]) * log(1 - p))");
    dshow("let fit = minimize_newton(fn b -> -ℓ(b), zeros(2, 1));");
    dshow("fit.x");
    dshow("fit.iters");
    dshow("let V = inv(hess(fn b -> -ℓ(b))(fit.x));");
    dshow("sqrt([V[1, 1]; V[2, 2]])");
