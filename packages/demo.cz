    dshow("show(dn(powc(X, 5), 3))");
    dshow("format(4)");
    dshow("load(\"packages/symb.cz\")");
    dshow("deriv(\"sin(x)/x\")");
    dshow("deriv(\"x^3 + 5*sin(x)\")");
    dshow("deriv(\"exp(-x^2)\")");
    dshow("let d = fn f -> fn x -> (f(x + h) - f(x - h)) / (2 * h) where h = 1e-6");
    dshow("abs(evalx(ddx(parse(\"sin(x)/x\")), 1.5) - d(fn t -> sin(t) / t)(1.5)) < 1e-8");
    dshow("format(6)");
    dshow("load(\"packages/symb.cz\")");
    dshow("let f = dfun(\"sin(x)/x\");");
    dshow("fzero(f, 4, 5)");
    dshow("fminbnd(ffun(\"sin(x)/x\"), 4, 5)");
    dshow("integral(dfun(\"x^3\"), 1, 2)");
    dshow("ffun(\"x^3\")(2) - ffun(\"x^3\")(1)");
    dshow("rng(2); mean(-1.96 < z < 1.96) where z = randn(1, 10000)");
    dshow("(-b + [-d, d]) / (2 * a) where a = 1, b = -3, c = 2, d = sqrt(b ^ 2 - 4 * a * c)");
    dshow("1:m ~> (fn k -> prod[j = 1:k] (1 - (j - 1) / 365)) |> (fn p -> find(p < 0.5)[1]) where m = 60");
    dshow("rng(7); rand(1, 500) |> {mu = mean, sd = std, hi = max, lo = min}");
    dshow("let zap = fn v -> pick(abs(v) < 1e-12, 0, v)");
    dshow("let fa = fn f, k -> integral(fn x -> f(x) * cos(k * x), -pi, pi) / pi");
    dshow("let fb = fn f, k -> integral(fn x -> f(x) * sin(k * x), -pi, pi) / pi");
    dshow("let spectrum = fn n -> {a = fn f -> zap(0:n ~> (fn k -> fa(f, k))), b = fn f -> zap(1:n ~> (fn k -> fb(f, k)))}");
    dshow("let s = spectrum(4);");
    dshow("(fn x -> x) |> {a = s.a, b = s.b}");
    null) end;
  null)

let next = fn -> (
  if demo_cursec == 0 then print("  no section running — demo15 (etc.) starts one")
  elseif demo_curprob >= demo_seclens[demo_cursec] then (print("  section finished — pick another (demo1..demo15)"); demo_cursec = 0)
  else (demo_curprob = demo_curprob + 1; demo_playprob(demo_cursec, demo_curprob);
    if demo_curprob < demo_seclens[demo_cursec] then print("        [ next for the next problem ]") else (print("        [ section finished — demo1..demo15 for another ]"); demo_cursec = 0) end)
  end; null)

let demo1 = fn -> (demo_cursec = 1; demo_curprob = 0; next())
let demo2 = fn -> (demo_cursec = 2; demo_curprob = 0; next())
let demo3 = fn -> (demo_cursec = 3; demo_curprob = 0; next())
let demo4 = fn -> (demo_cursec = 4; demo_curprob = 0; next())
let demo5 = fn -> (demo_cursec = 5; demo_curprob = 0; next())
let demo6 = fn -> (demo_cursec = 6; demo_curprob = 0; next())
let demo7 = fn -> (demo_cursec = 7; demo_curprob = 0; next())
let demo8 = fn -> (demo_cursec = 8; demo_curprob = 0; next())
let demo9 = fn -> (demo_cursec = 9; demo_curprob = 0; next())
let demo10 = fn -> (demo_cursec = 10; demo_curprob = 0; next())
let demo11 = fn -> (demo_cursec = 11; demo_curprob = 0; next())
let demo12 = fn -> (demo_cursec = 12; demo_curprob = 0; next())
let demo13 = fn -> (demo_cursec = 13; demo_curprob = 0; next())
let demo14 = fn -> (demo_cursec = 14; demo_curprob = 0; next())
let demo15 = fn -> (demo_cursec = 15; demo_curprob = 0; next())

let demo = fn -> (
  let going = true;
  while going do
    demo_menu();
    let s = trim(input("  section (number, a = all, q = quit): "));
    if s == "q" | s == "" then (going = false)
    elseif s == "a" then (demo_sec1(); demo_sec2(); demo_sec3(); demo_sec4(); demo_sec5(); demo_sec6(); demo_sec7(); demo_sec8(); demo_sec9(); demo_sec10(); demo_sec11(); demo_sec12(); demo_sec13(); demo_sec14(); demo_sec15(); print(""); print("  Tour complete — the book has the prose."); going = false)
    elseif s == "1" then demo_sec1()
    elseif s == "2" then demo_sec2()
    elseif s == "3" then demo_sec3()
    elseif s == "4" then demo_sec4()
    elseif s == "5" then demo_sec5()
    elseif s == "6" then demo_sec6()
    elseif s == "7" then demo_sec7()
    elseif s == "8" then demo_sec8()
    elseif s == "9" then demo_sec9()
    elseif s == "10" then demo_sec10()
    elseif s == "11" then demo_sec11()
    elseif s == "12" then demo_sec12()
    elseif s == "13" then demo_sec13()
    elseif s == "14" then demo_sec14()
    elseif s == "15" then demo_sec15()
    else praw("  (unrecognized: " + s + ")") end
  end; null)

demo_menu()
