    dshow("let Sig = [0.09, 0.01, 0.00; 0.01, 0.04, 0.01; 0.00, 0.01, 0.01];");
    dshow("let obj = fn w -> sum(w .* (Sig * w)) - 0.5 * sum(mu .* w)");
    dshow("let m = minimize_con(obj, [0.3; 0.3; 0.4], {eq = fn w -> [sum(w) - 1], ineq = fn w -> -w}); m.converged");
    dshow("m.x");
