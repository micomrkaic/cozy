    dshow("load(\"packages/dist.cz\"); format(4)");
    dshow("let s0 = 100; let strike = 105; let r = 0.03; let sig = 0.2; let T = 1;");
    dshow("let d1 = (log(s0 / strike) + (r + sig ^ 2 / 2) * T) / (sig * sqrt(T));");
    dshow("let bs = s0 * norm.cdf(d1, 0, 1) - strike * exp(-r * T) * norm.cdf(d1 - sig * sqrt(T), 0, 1)");
    dshow("rng(11); let st = s0 * exp((r - sig ^ 2 / 2) * T + sig * sqrt(T) * randn(1, 200000));");
    dshow("exp(-r * T) * mean(pick(st > strike, st - strike, 0))");
