% demo.cz — GENERATED from BOOK.md by tools/gen_demo.py. Do not edit.
% The demo and the book of examples are the same examples by construction:
% every line below is a transcript input from the book, replayed live.
% make test regenerates and diffs this file (the sync is a suite check).
%
%   demo()    the interactive tour: menu, pick a section, Enter advances
%   (a at the menu plays everything; the suite pipes that path headless)

let praw = fn t -> print(strrep(strrep(t, "{", "{{"), "}", "}}"))
let isnil = fn v -> str(v) == "null"
let ans = null
let dshow = fn s -> (praw("cozy> " + s); let v = eval(s); if !isnil(v) & !endswith(s, ";") then (ans = v; praw(str(v))) end; null)
let dwait = fn -> pause("        [ Enter for the next problem ] ")
let dhead = fn t -> (format(6); print(""); praw("  ── Problem " + t); print(""))

let demo_sec1 = fn -> (
  print("");
  praw("  ═══ Section 1: 1. Basic calculations ═══");
  dhead("1.1 — Splitting the bill");
  dshow("format(\"fixed\", 2)");
  dshow("let bill = 87.40; bill * 1.15");
  dshow("ans / 4");
  dwait();
  dhead("1.2 — How much paint?");
  dshow("let area = 2 * (5.2 + 3.8) * 2.6 - 1.9 * 0.9 - 2 * 1.2 * 1.4;");
  dshow("area");
  dshow("area / 10");
  dshow("ceil(ans)");
  dwait();
  dhead("1.3 — Growth rates");
  dshow("format(4)");
  dshow("(68.4 / 51.2) ^ (1 / 6) - 1");
  dshow("let years = fn r -> log(2) / log(1 + r); years(ans)");
  dwait();
  dhead("1.4 — A currency helper");
  dshow("format(\"fixed\", 2)");
  dshow("let eur = fn usd -> usd / 1.0865;");
  dshow("eur(1500)");
  dshow("[19.99, 45.50, 129] ~> eur");
  null)

let demo_sec2 = fn -> (
  print("");
  praw("  ═══ Section 2: 2. Values and types ═══");
  dhead("2.1 — The type zoo");
  dshow("let n = 42; let x = 2.5; let ok = true; let s = \"helium\";");
  dshow("let v = [1.5, 2.5]; let M = [1, 2; 3, 4]; let z = 3 + 4i;");
  dshow("let r = {name = \"boron\", Z = 5}; let f = fn t -> t ^ 2;");
  dshow("who");
  dwait();
  dhead("2.2 — How numbers behave");
  dshow("7 / 2");
  dshow("2 ^ 10");
  dshow("2 ^ 0.5");
  dshow("floor(7 / 2)");
  dshow("[1, 5, 2, 8] > 3");
  dshow("sum([1, 5, 2, 8] > 3)");
  dshow("pick(true, 10, 20)");
  dwait();
  dhead("2.3 — Floating-point honesty");
  dshow("0.1 + 0.2 == 0.3");
  dshow("abs(0.1 + 0.2 - 0.3) < eps * 4");
  dshow("1 / 0");
  dshow("-1 / 0");
  dshow("0 / 0");
  dshow("nan == nan");
  null)

let demo_sec3 = fn -> (
  print("");
  praw("  ═══ Section 3: 3. Strings ═══");
  dhead("3.1 — Cleanup and assembly");
  dshow("let name = \"  Cozy  \";");
  dshow("trim(name)");
  dshow("upper(ans)");
  dshow("length(trim(name))");
  dshow("\"version \" + str(2.5) + \", \" + str(153) + \" builtins\"");
  dwait();
  dhead("3.2 — Formatted reporting");
  dshow("fmt(\"pmt = {:.2f} at i = {:.4f}\", -1984.153, 0.0575 / 12)");
  dshow("fmt(\"{} of {} lots pass\", 18, 20)");
  dwait();
  dhead("3.3 — Parsing a data line");
  dshow("let csvline = \"2026-07-25,close,187.44\";");
  dshow("let parts = strsplit(csvline, \",\")");
  dshow("num(parts[3])");
  dshow("strjoin(parts, \" | \")");
  dshow("strrep(csvline, \",\", \";\")");
  dwait();
  dhead("3.4 — Predicates over listings");
  dshow("ls(\"packages\")");
  dshow("ans ~> (fn f -> endswith(f, \".cz\")) |> all");
  dshow("ls(\"packages\") ~> (fn f -> contains(f, \"s\")) |> sum");
  dwait();
  dhead("3.5 — Between text and values");
  dshow("strsplit(\"3.14, 2.71, 1.41\", \",\") ~> trim ~> num");
  dshow("strsplit(\"10 20 30\", \" \") ~> num |> sum");
  dshow("[1.5, 2.5, 3.5] ~> str |> (fn a -> strjoin(a, \" | \"))");
  dshow("let r = {rate = 0.0575, n = 360}; str(r)");
  dshow("fields(r)");
  null)

let demo_sec4 = fn -> (
  print("");
  praw("  ═══ Section 4: 4. Complex numbers ═══");
  dhead("4.1 — Impedance of a series RLC circuit");
  dshow("format(4)");
  dshow("let f = 60; let R = 100; let L = 0.25; let C = 20e-6;");
  dshow("let w = 2 * pi * f;");
  dshow("let Z = R + 1i * w * L + 1 / (1i * w * C)");
  dshow("abs(Z)");
  dshow("angle(Z) * 180 / pi");
  dshow("230 / abs(Z)");
  dwait();
  dhead("4.2 — Fifth roots of unity");
  dshow("format(4)");
  dshow("let z = exp(2i * pi / 5)");
  dshow("let zpow = fn n -> prod[k = 1:n] z");
  dshow("abs(zpow(5) - 1) < 1e-12");
  dshow("abs(sum[k = 0:4] zpow(k)) < 1e-12");
  dshow("abs(z - 1)");
  dwait();
  dhead("4.3 — Rotation as multiplication");
  dshow("format(4)");
  dshow("let p = 3 + 2i;");
  dshow("p * exp(1i * pi / 3)");
  dshow("abs(ans - p)");
  null)

let demo_sec5 = fn -> (
  print("");
  praw("  ═══ Section 5: 5. Matrices ═══");
  dhead("5.1 — The construction kit");
  dshow("let A = [1, 2; 3, 4]");
  dshow("zeros(2, 3)");
  dshow("eye(3)");
  dshow("diag([5, 6, 7])");
  dshow("reshape(1:6, 2, 3)");
  dshow("repmat([1, 0], 2, 2)");
  dshow("let B = eye(2); [A; B]");
  dshow("[A, A]");
  dwait();
  dhead("5.2 — Getting at the elements");
  dshow("let A = reshape(1:12, 3, 4)");
  dshow("A[2, 3]");
  dshow("A[2, :]");
  dshow("A[:, 4]");
  dshow("A[1, 1] = 100; A");
  dshow("let v = [10, 20, 30, 40]; v[v > 15]");
  dwait();
  dhead("5.3 — Two multiplications");
  dshow("let A = [1, 2; 3, 4]; let B = [0, 1; 1, 0];");
  dshow("A + B");
  dshow("A * B");
  dshow("A .* B");
  dshow("A ^ 2");
  dshow("A .^ 2");
  dshow("A * 10 + 1");
  dshow("A.'");
  dwait();
  dhead("5.4 — What you see");
  dshow("let A = [1/3, 2/3; 1, 4/3];");
  dshow("A");
  dshow("format(10); A");
  dshow("format(6);");
  dshow("size(A)");
  dshow("numel(A)");
  dshow("let big = rand(50, 50); size(big)");
  dshow("who");
  null)

let demo_sec6 = fn -> (
  print("");
  praw("  ═══ Section 6: 6. Reading and writing data ═══");
  dhead("6.1 — Round-trip through a file");
  dshow("format(4)");
  dshow("rng(5)");
  dshow("let yield_data = [10 + randn(1, 6) * 0.5; 12 + randn(1, 6) * 0.5].';");
  dshow("writecsv(\"/tmp/yield.csv\", yield_data)");
  dshow("let back = readcsv(\"/tmp/yield.csv\");");
  dshow("size(back)");
  dshow("mean(back, 1)");
  dshow("corr(back[:, 1], back[:, 2])");
  dwait();
  dhead("6.2 — A table with names");
  dshow("let w = readtable(\"tests/data/weather.csv\")");
  dshow("mean(w.temp)");
  dshow("sum(w.rain > 0)");
  dshow("w.temp[find(w.rain == 0)]");
  dshow("w.temp |> {hi = max, lo = min, mu = mean}");
  null)

let demo_sec7 = fn -> (
  print("");
  praw("  ═══ Section 7: 7. Writing your own functions ═══");
  dhead("7.1 — A progressive tax");
  dshow("format(\"fixed\", 2)");
  dshow("let tax = fn inc -> if inc <= 11000 then inc * 0.10 elseif inc <= 44725 then 1100 + (inc - 11000) * 0.12 else 5147 + (inc - 44725) * 0.22 end");
  dshow("tax(9500)");
  dshow("tax(30000)");
  dshow("tax(60000)");
  dwait();
  dhead("7.2 — Euclid, verbatim");
  dshow("let gcd = fn a, b -> if b == 0 then a else gcd(b, mod(a, b)) end");
  dshow("gcd(1071, 462)");
  dshow("gcd(35, 64)");
  dwait();
  dhead("7.3 — Body mass index, with provenance");
  dshow("format(3)");
  dshow("let bmi = fn kg, cm -> kg / (cm / 100) ^ 2");
  dshow("bmi(82, 178)");
  dshow("body(bmi)");
  null)

let demo_sec8 = fn -> (
  print("");
  praw("  ═══ Section 8: 8. Anonymous functions and pipes ═══");
  dhead("8.1 — The pipe family on one array");
  dshow("format(4)");
  dshow("let x = [3, 1, 4, 1, 5, 9, 2, 6];");
  dshow("x |> sort");
  dshow("x ~> (@ ^ 2 - 1)");
  dshow("x |> sort |>> (@) |> median");
  dshow("x |> {n = length, mu = mean, rng = fn v -> max(v) - min(v)}");
  dwait();
  dhead("8.2 — Weekly payroll with overtime");
  dshow("format(\"fixed\", 2)");
  dshow("let hours = [38, 42.5, 40, 45, 36.5];");
  dshow("hours ~> (fn h -> if h <= 40 then h * 22 else 880 + (h - 40) * 33 end)");
  dshow("ans |> sum");
  null)

let demo_sec9 = fn -> (
  print("");
  praw("  ═══ Section 9: 9. Records ═══");
  dhead("9.1 — A parts bin");
  dshow("format(\"fixed\", 2)");
  dshow("let bolt = {sku = \"M8x40\", price = 0.42, stock = 1180};");
  dshow("let nut = {sku = \"M8n\", price = 0.11, stock = 2600};");
  dshow("bolt.price * 200 + nut.price * 200");
  dshow("fields(bolt)");
  dshow("let bolt = {sku = bolt.sku, price = bolt.price * 1.06, stock = bolt.stock}; bolt.price");
  dwait();
  dhead("9.2 — A measurement report");
  dshow("rng(3); format(4)");
  dshow("let sample = randn(1, 400);");
  dshow("let report = sample |> {n = length, mu = mean, sd = std, q90 = fn v -> quantile(v, 0.9)}");
  dshow("report.q90");
  dwait();
  dhead("9.9 — A namespace is a record that grew up");
  dshow("let stats = {se = fn v -> sqrt(v / 100), z = fn m -> m / stats.se(4.0)}");
  dshow("stats.z(0.5)");
  dshow("getfield(stats, \"z\")(0.5)");
  dshow("fields(stats)'");
  null)

let demo_sec10 = fn -> (
  print("");
  praw("  ═══ Section 10: 10. Calculus ═══");
  dhead("10.1 — Work against gravity");
  dshow("format(6)");
  dshow("integral(fn x -> 4000 / (1 + x / 6371) ^ 2, 0, 400)");
  dwait();
  dhead("10.2 — Where does the beam bend most?");
  dshow("format(5)");
  dshow("let defl = fn x -> x ^ 2 * (3 * 4 - x) / (6 * 2.1e4)");
  dshow("defl(4)");
  dshow("fminbnd(fn x -> -defl(x), 0, 4)");
  dwait();
  dhead("10.3 — Kepler's equation");
  dshow("format(6)");
  dshow("let M = 1.5; let ecc = 0.4;");
  dshow("let E = fzero(fn x -> x - ecc * sin(x) - M, 0, pi)");
  dshow("E - ecc * sin(E)");
  dwait();
  dhead("10.4 — Exact vs numerical");
  dshow("load(\"packages/poly.cz\"); format(4)");
  dshow("let p = [1, -2, 0, 3];");
  dshow("polyval(p, 2)");
  dshow("let dp = polyder(p)");
  dshow("polyval(dp, 2)");
  dshow("let P = polyint(p, 0); polyval(P, 2) - polyval(P, 0)");
  dshow("integral(fn x -> polyval(p, x), 0, 2)");
  dwait();
  dhead("10.5 — Fourier coefficients for any function");
  dshow("format(4)");
  dshow("let zap = fn v -> pick(abs(v) < 1e-12, 0, v)");
  dshow("let fa = fn f, k -> integral(fn x -> f(x) * cos(k * x), -pi, pi) / pi");
  dshow("let fb = fn f, k -> integral(fn x -> f(x) * sin(k * x), -pi, pi) / pi");
  dshow("let sq = fn x -> pick(x > 0, 1, -1);");
  dshow("zap(1:5 ~> (fn k -> fb(sq, k)))");
  dshow("4 / pi * [1, 0, 1/3, 0, 1/5]");
  dshow("(sum[k = 1:n] fb(sq, k) * sin(k * x)) where n = 40, x = 1");
  dwait();
  dhead("10.6 — The spectrum analyzer, one pipe wide");
  dshow("format(4)");
  dshow("let zap = fn v -> pick(abs(v) < 1e-12, 0, v)");
  dshow("let fa = fn f, k -> integral(fn x -> f(x) * cos(k * x), -pi, pi) / pi");
  dshow("let fb = fn f, k -> integral(fn x -> f(x) * sin(k * x), -pi, pi) / pi");
  dshow("let spectrum = fn n -> {a = fn f -> zap(0:n ~> (fn k -> fa(f, k))), b = fn f -> zap(1:n ~> (fn k -> fb(f, k)))}");
  dshow("let s = spectrum(4);");
  dshow("(fn x -> x) |> {a = s.a, b = s.b}");
  dshow("(fn x -> x ^ 2) |> {a = s.a, b = s.b}");
  dwait();
  dhead("10.7 — |x| drawn from cosines");
  dshow("format(4)");
  dshow("let zap = fn v -> pick(abs(v) < 1e-12, 0, v)");
  dshow("let fa = fn f, k -> integral(fn x -> f(x) * cos(k * x), -pi, pi) / pi");
  dshow("let a = zap(0:9 ~> (fn k -> fa(abs, k)))");
  dshow("[pi, -4/pi, -4/(9*pi), -4/(25*pi)]");
  dshow("let S = fn x -> a[1] / 2 + (sum[k = 1:9] a[k + 1] * cos(k * x))");
  dshow("let xs = -pi:0.05:pi;");
  dshow("max(abs((xs ~> abs) - (xs ~> S)))");
  dshow("plot(xs, [xs ~> abs; xs ~> S]', {title = \"|x| and its 10-term Fourier series\", label1 = \"|x|\", label2 = \"S\"})");
  dwait();
  dhead("10.8 — Gibbs: the overshoot that will not die");
  dshow("format(4)");
  dshow("let zap = fn v -> pick(abs(v) < 1e-12, 0, v)");
  dshow("let fb = fn f, k -> integral(fn x -> f(x) * sin(k * x), -pi, pi) / pi");
  dshow("let sq = fn x -> pick(x > 0, 1, -1)");
  dshow("let b = zap(1:9 ~> (fn k -> fb(sq, k)))");
  dshow("let S9 = fn x -> sum[k = 1:9] b[k] * sin(k * x)");
  dshow("max((0:0.002:1) ~> S9)");
  dshow("let S99 = fn x -> 4 / pi * (sum[j = 1:50] sin((2 * j - 1) * x) / (2 * j - 1))");
  dshow("max((0:0.0005:0.2) ~> S99)");
  dshow("2 / pi * integral(fn t -> sin(t) / t, 1e-9, pi)");
  dshow("plot(-pi:0.02:pi, [(-pi:0.02:pi) ~> sq; (-pi:0.02:pi) ~> S9]', {title = \"square wave, 9 terms: Gibbs\", label1 = \"sq\", label2 = \"S9\"})");
  dwait();
  dhead("10.9 — The derivative as an operator");
  dshow("format(4)");
  dshow("let d = fn f -> fn x -> (f(x + h) - f(x - h)) / (2 * h) where h = 1e-6");
  dshow("d(sin)(0)");
  dshow("d(fn x -> x ^ 3)(2)");
  dshow("let arclen = fn f, a, b -> integral(fn x -> sqrt(1 + d(f)(x) ^ 2), a, b)");
  dshow("arclen(sin, 0, 2 * pi)");
  dshow("arclen(fn x -> x, 0, 1)");
  dwait();
  dhead("10.10 — A gallery of famous integrals");
  dshow("format(6)");
  dshow("let gam = fn s -> integral(fn t -> t ^ (s - 1) * exp(-t), 0, 60); gam(5)");
  dshow("(2 * integral(fn u -> exp(-u ^ 2), 0, 10)) ^ 2");
  dshow("(2 * prod[k = 1:n] 4 * k ^ 2 / (4 * k ^ 2 - 1)) where n = 10000");
  dshow("4 * integral(fn x -> sqrt(1 - x ^ 2), 0, 1)");
  null)

let demo_sec11 = fn -> (
  print("");
  praw("  ═══ Section 11: 11. Linear algebra ═══");
  dhead("11.1 — The mixing problem");
  dshow("format(4)");
  dshow("let A = [0.10, 0.25; 0.90, 0.75]; let b = [40; 160];");
  dshow("A \\ b");
  dshow("A * ans");
  dwait();
  dhead("11.2 — Leontief input-output");
  dshow("format(4)");
  dshow("let A = [0.2, 0.3; 0.4, 0.1]; let d = [100; 150];");
  dshow("let x = (eye(2) - A) \\ d");
  dshow("(eye(2) - A) * x");
  dwait();
  dhead("11.3 — Calibrating a sensor");
  dshow("load(\"packages/poly.cz\"); format(4)");
  dshow("let t = [0, 1, 2, 3, 4, 5]; let y = [2.1, 3.9, 6.2, 7.8, 10.1, 12.2];");
  dshow("let c = polyfit(t, y, 1)");
  dshow("polyval(c, 6)");
  dwait();
  dhead("11.4 — Where does the weather settle?");
  dshow("format(4)");
  dshow("let P = [0.9, 0.1; 0.3, 0.7];");
  dshow("let r = eig(P.')");
  dshow("let idx = find(abs(r.values - 1) < 1e-9)[1]");
  dshow("let v = r.vectors[:, idx]; let s = v / sum(v)");
  dshow("P.' * s");
  null)

let demo_sec12 = fn -> (
  print("");
  praw("  ═══ Section 12: 12. Probability, statistics, and data ═══");
  dhead("12.1 — Acceptance sampling");
  dshow("load(\"packages/dist.cz\"); format(4)");
  dshow("let p_defect = fn k -> gamma(21) / (gamma(k + 1) * gamma(21 - k)) * 0.05 ^ k * 0.95 ^ (20 - k)");
  dshow("sum[k = 0:2] p_defect(k)");
  dshow("1 - ans");
  dshow("p_defect(0)");
  dwait();
  dhead("12.2 — A confidence interval by hand");
  dshow("rng(2)");
  dshow("let z = randn(1, 10000);");
  dshow("mean(-1.96 < z < 1.96)");
  dshow("sum(z > 3)");
  dshow("mean(abs(z) > 2.576)");
  dwait();
  dhead("12.3 — Pi by Monte Carlo");
  dshow("rng(42); format(4)");
  dshow("let n = 100000;");
  dshow("let x = rand(1, n); let y = rand(1, n);");
  dshow("4 * sum(x .^ 2 + y .^ 2 < 1) / n");
  dshow("pi");
  dwait();
  dhead("12.4 — The Central Limit Theorem, watched");
  dshow("rng(7); format(4)");
  dshow("let draws = mean(rand(500, 12), 2);");
  dshow("let z = (draws - mean(draws)) / std(draws);");
  dshow("sum(-1.96 < z < 1.96) / 500");
  null)

let demo_sec13 = fn -> (
  print("");
  praw("  ═══ Section 13: 13. Plotting ═══");
  dhead("13.1 — A function, seen");
  dshow("plot(0:0.5:6, sin(0:0.5:6), {title = \"sin(x)\"})");
  dwait();
  dhead("13.2 — The shape of randn");
  dshow("rng(9); hist(randn(1, 400), 12, {title = \"400 draws of randn\"})");
  dwait();
  dhead("13.3 — A scatter with the package");
  dshow("load(\"packages/scatter.cz\")");
  dshow("rng(4); let x = rand(1, 40); let noise = randn(1, 40) * 0.15;");
  dshow("scatter_titled(x, 2 * x + noise, \"y = 2x + noise\")");
  null)

let demo_sec14 = fn -> (
  print("");
  praw("  ═══ Section 14: 14. The Cozy idiom ═══");
  dhead("14.1 — Functions as ordinary values");
  dshow("let twice = fn f, x -> f(f(x))");
  dshow("twice(fn t -> t + 3, 10)");
  dshow("let make_pow = fn p -> fn x -> x ^ p; let cube = make_pow(3); cube(4)");
  dshow("[1, 2, 3] ~> make_pow(2)");
  dwait();
  dhead("14.2 — `where`: the blackboard's word order");
  dshow("sqrt(b ^ 2 - 4 * a * c) where a = 1, b = -3, c = 2");
  dshow("(-b + [-d, d]) / (2 * a) where a = 1, b = -3, c = 2, d = sqrt(b ^ 2 - 4 * a * c)");
  dshow("1:n ~> (@ ^ 2) |> sum where n = 5");
  dwait();
  dhead("14.3 — Sigma notation, working");
  dshow("(sum[k = 1:n] 1 / k ^ 2) where n = 100000");
  dshow("pi ^ 2 / 6");
  dshow("sum[i = 1:4] sum[j = 1:4] pick(i == j, i, 0)");
  dshow("let dot_ = fn u, v -> sum[k = 1:length(u)] u[k] * v[k]; dot_([1, 2, 3], [4, 5, 6])");
  dwait();
  dhead("14.4 — The grand combinations");
  dshow("rng(1); A |> {a = det, b = inv} where A = eig(rand(2)).vectors");
  dshow("ans.a * det(ans.b)");
  dshow("rng(2); sum(-1.96 < z < 1.96) / n where n = 10000, z = randn(1, n)");
  dshow("1:m ~> (fn k -> prod[j = 1:k] (1 - (j - 1) / 365)) |> (fn p -> find(p < 0.5)[1]) where m = 60");
  dwait();
  dhead("12.5 — Composing a function with itself");
  dshow("format(4)");
  dshow("let selfcomp = fn f -> fn x -> f(f(x))");
  dshow("selfcomp(fn t -> t + 3)(10)");
  dshow("selfcomp(sqrt)(16)");
  dshow("[1, 2, 3] ~> selfcomp(fn t -> t * 10)");
  dshow("format(4)");
  dshow("let iterate = fn f, n -> if n <= 0 then (fn x -> x) else (fn x -> f(iterate(f, n - 1)(x))) end");
  dshow("iterate(fn t -> t * 2, 10)(1)");
  dshow("iterate(fn t -> sqrt(1 + t), 40)(1)");
  dshow("(1 + sqrt(5)) / 2");
  dshow("format(4)");
  dshow("let d = fn f -> fn x -> (f(x + h) - f(x - h)) / (2 * h) where h = 1e-4");
  dshow("let selfcomp = fn f -> fn x -> f(f(x));");
  dshow("selfcomp(d)(sin)(pi / 3)");
  dshow("-sin(pi / 3)");
  null)

let demo_sec15 = fn -> (
  print("");
  praw("  ═══ Section 15: 15. The Cozy instruments ═══");
  dhead("15.1 — A sparse system, solved without ever densifying");
  dshow("let n = 400;");
  dshow("let i = [1:n, 1:n-1, 2:n]; let j = [1:n, 2:n, 1:n-1];");
  dshow("let v = [2 * ones(1, n), -ones(1, n-1), -ones(1, n-1)];");
  dshow("let L = sparse(i, j, v, n, n)");
  dshow("load(\"packages/sparselin.cz\");");
  dshow("let s = cg(L, ones(n, 1)); s.iters");
  dshow("s.relres < 1e-9");
  dshow("sl_norm(dense(L) * s.x - ones(n, 1)) < 1e-7");
  dwait();
  dhead("15.2 — Derivatives that are exact, not approximate");
  dshow("load(\"packages/autodiff.cz\"); format(6)");
  dshow("d(fn x -> exp(sin(x^2)))(1)");
  dshow("2 * cos(1) * exp(sin(1))");
  dshow("let rosen = fn x -> (1 - x[1])^2 + 100 * (x[2] - x[1]^2)^2; grad(rosen)([1.0; 1.0])");
  dwait();
  dhead("15.3 — Constrained maximization: a portfolio");
  dshow("load(\"packages/optim.cz\"); format(4)");
  dshow("let mu = [0.10; 0.06; 0.04];");
  dshow("let Sig = [0.09, 0.01, 0.00; 0.01, 0.04, 0.01; 0.00, 0.01, 0.01];");
  dshow("let obj = fn w -> sum(w .* (Sig * w)) - 0.5 * sum(mu .* w)");
  dshow("let m = minimize_con(obj, [0.3; 0.3; 0.4], {eq = fn w -> [sum(w) - 1], ineq = fn w -> -w}); m.converged");
  dshow("m.x");
  dshow("sum(m.x)");
  dwait();
  dhead("15.4 — Estimation: the closure is the estimator");
  dshow("load(\"packages/optim.cz\"); format(4)");
  dshow("let x = (1:20)' * 0.25; let y = 2.5 * exp(-0.8 * x) + 0.01 * randn(20, 1);");
  dshow("let make_ssr = fn x, y -> fn b -> sum((y - b[1] * exp(b[2] * x)) .* (y - b[1] * exp(b[2] * x)))");
  dshow("minimize(make_ssr(x, y), [1.0; -0.1]).x");
  dwait();
  dhead("15.5 — Life-cycle consumption: the Euler equation falls out");
  dshow("load(\"packages/optim.cz\")");
  dshow("let T = 5; let β = 0.96; let R = 1.04; let W = 100.0");
  dshow("let U = fn c -> sum[t = 1:T] β^(t - 1) * log(c[t])");
  dshow("let sol = maximize_con(U, W / T * ones(T, 1), {eq = fn c -> [(sum[t = 1:T] c[t] / R^(t - 1)) - W]});");
  dshow("sol.x");
  dshow("abs(sol.x[2] / sol.x[1] - β * R) < 1e-4");
  dshow("abs((sum[t = 1:T] sol.x[t] / R^(t - 1)) - W) < 1e-9");
  dwait();
  dhead("15.6 — Minimum variance, numerically and in closed form");
  dshow("load(\"packages/optim.cz\")");
  dshow("let Σ = [0.04, 0.006, 0.0; 0.006, 0.09, 0.012; 0.0, 0.012, 0.16]");
  dshow("let vol2 = fn w -> sum(w .* (Σ * w))");
  dshow("let sol = minimize_con(vol2, ones(3, 1) / 3, {eq = fn w -> [sum(w) - 1]});");
  dshow("sol.x");
  dshow("let wstar = (Σ \\ ones(3, 1)) / sum(Σ \\ ones(3, 1));");
  dshow("max(abs(sol.x - wstar)) < 1e-5");
  dshow("sqrt(vol2(sol.x))");
  dwait();
  dhead("15.7 — GMM from generated data: two steps and a J test");
  dshow("load(\"packages/optim.cz\"); rng(7)");
  dshow("let n = 400; let z1 = randn(n, 1); let z2 = randn(n, 1); let Z = [z1, z2]");
  dshow("let v = randn(n, 1); let x = z1 + 0.5 * z2 + v; let y = 1.5 * x + 0.7 * v + 0.3 * randn(n, 1)");
  dshow("let g = fn b -> Z' * (y - x * b) / n");
  dshow("let β1 = minimize(fn b -> sum(g(b[1]) .* g(b[1])), [0.0]).x[1]; β1");
  dshow("let e = y - x * β1; let M = Z .* (e * ones(1, 2)); let Si = inv(M' * M / n);");
  dshow("let fit = minimize(fn b -> sum(g(b[1]) .* (Si * g(b[1]))), [β1]);");
  dshow("fit.x[1]");
  dshow("n * fit.fx");
  dwait();
  dhead("15.8 — Taylor by quotation: the language reads its own sin");
  dshow("load(\"packages/symb.cz\")");
  dshow("let f = ast(fn x -> sin(x)).body");
  dshow("let dtree = fn e, k -> if k == 0 then e else dtree(ddx(e), k - 1) end");
  dshow("let x = 0.0;");
  dshow("let c = (0:7) ~> (fn k -> eval(show(simp(dtree(f, k)))) / gamma(k + 1)); c");
  dshow("let Tn = fn m, u -> sum[k = 0:m] c[k + 1] * u^k");
  dshow("abs(Tn(7, 1.0) - sin(1.0)) < 3e-5");
  dshow("let xs = -pi:0.1:pi;");
  dshow("plot(xs, [xs ~> sin; xs ~> (fn u -> Tn(1, u)); xs ~> (fn u -> Tn(3, u)); xs ~> (fn u -> Tn(7, u))]', {title = \"sin and its Taylor truncations\", label1 = \"sin\", label2 = \"T1\", label3 = \"T3\", label4 = \"T7\"})");
  dwait();
  dhead("15.9 — Probit by Newton: exact scores, exact information");
  dshow("load(\"packages/optim.cz\"); load(\"packages/dist.cz\"); rng(12)");
  dshow("let n = 600; let βtrue = [0.5; -1.0]");
  dshow("let X = [ones(n, 1), randn(n, 1)]");
  dshow("let ε = randn(n, 1); let y = pick(X * βtrue + ε > 0, 1.0, 0.0);");
  dshow("let Φ = dist_Phi");
  dshow("let ℓ = fn b -> sum[i = 1:n] (let p = Φ((X[i, :] * b)[1, 1]); y[i] * log(p) + (1 - y[i]) * log(1 - p))");
  dshow("let fit = minimize_newton(fn b -> -ℓ(b), zeros(2, 1));");
  dshow("fit.x");
  dshow("fit.iters");
  dshow("let V = inv(hess(fn b -> -ℓ(b))(fit.x));");
  dshow("sqrt([V[1, 1]; V[2, 2]])");
  dshow("load(\"packages/finance.cz\")");
  dshow("let price = 425000; let down = 0.20;");
  dshow("let principal = price * (1 - down)");
  dshow("pmt(n, i, principal, 0) where n = 360, i = 0.0575 / 12");
  dshow("ans * 360");
  dshow("nper(0.0575 / 12, principal, -1984.15 - 300, 0) / 12");
  dshow("load(\"packages/finance.cz\"); format(4)");
  dshow("bond_price(0.045, 0.052, 10, 2, 100)");
  dshow("bond_duration(0.045, 0.052, 10, 2, 100)");
  dshow("load(\"packages/finance.cz\"); format(2)");
  dshow("let cf = [-50000, 12000, 15000, 18000, 21000, 9000];");
  dshow("npv(0.08, cf)");
  dshow("irr(cf) * 100");
  dshow("load(\"packages/dist.cz\"); format(4)");
  dshow("let s0 = 100; let strike = 105; let r = 0.03; let sig = 0.2; let T = 1;");
  dshow("let d1 = (log(s0 / strike) + (r + sig ^ 2 / 2) * T) / (sig * sqrt(T));");
  dshow("let bs = s0 * norm.cdf(d1, 0, 1) - strike * exp(-r * T) * norm.cdf(d1 - sig * sqrt(T), 0, 1)");
  dshow("rng(11); let st = s0 * exp((r - sig ^ 2 / 2) * T + sig * sqrt(T) * randn(1, 200000));");
  dshow("exp(-r * T) * mean(pick(st > strike, st - strike, 0))");
  dshow("load(\"packages/astro.cz\")");
  dshow("hm(sunrise(46.05, 14.51, 2026, 7, 25, 2))");
  dshow("hm(sunset(46.05, 14.51, 2026, 7, 25, 2))");
  dshow("hm(day_length(46.05, 14.51, 2026, 7, 25))");
  dshow("load(\"packages/astro.cz\"); format(3)");
  dshow("moon_age(2026, 7, 25)");
  dshow("moon_illum(2026, 7, 25) * 100");
  dshow("load(\"packages/phys.cz\"); format(4)");
  dshow("let Me = 5.972e24; let Re = 6.371e6;");
  dshow("sqrt(phys.G * Me / (Re + 4e5))");
  dshow("sqrt(2 * phys.G * Me / Re)");
  dshow("load(\"packages/phys.cz\"); format(4)");
  dshow("phys.k * 300 / phys.eV");
  dshow("phys.hbar * phys.c / (phys.k * 2.7255) * 1000");
  dshow("load(\"packages/rmt.cz\"); rng(1); format(3)");
  dshow("let H = goe(400);");
  dshow("let lam = eig(H).values;");
  dshow("max(abs(lam))");
  dshow("sum(abs(lam) < 1) / 400");
  dshow("format(4)");
  dshow("load(\"packages/symb.cz\")");
  dshow("let e = add(powc(X, 3), mul(C(5), sinx(X)));");
  dshow("show(simp(ddx(e)))");
  dshow("let d = fn f -> fn x -> (f(x + h) - f(x - h)) / (2 * h) where h = 1e-6");
  dshow("abs(evalx(ddx(e), 2) - d(fn t -> t ^ 3 + 5 * sin(t))(2)) < 1e-8");
  dshow("format(4)");
  dshow("load(\"packages/symb.cz\")");
  dshow("taylor(sinx(X), 7)");
  dshow("taylor(expx(X), 5)");
  dshow("show(dn(powc(X, 5), 3))");
  dshow("format(4)");
  dshow("load(\"packages/symb.cz\")");
  dshow("deriv(\"sin(x)/x\")");
  dshow("deriv(\"x^3 + 5*sin(x)\")");
  dshow("deriv(\"exp(-x^2)\")");
  dshow("let d = fn f -> fn x -> (f(x + h) - f(x - h)) / (2 * h) where h = 1e-6");
  dshow("abs(evalx(ddx(parse(\"sin(x)/x\")), 1.5) - d(fn t -> sin(t) / t)(1.5)) < 1e-8");
  dshow("format(6)");
  dshow("load(\"packages/symb.cz\")");
  dshow("let f = dfun(\"sin(x)/x\");");
  dshow("fzero(f, 4, 5)");
  dshow("fminbnd(ffun(\"sin(x)/x\"), 4, 5)");
  dshow("integral(dfun(\"x^3\"), 1, 2)");
  dshow("ffun(\"x^3\")(2) - ffun(\"x^3\")(1)");
  dshow("rng(2); mean(-1.96 < z < 1.96) where z = randn(1, 10000)");
  dshow("(-b + [-d, d]) / (2 * a) where a = 1, b = -3, c = 2, d = sqrt(b ^ 2 - 4 * a * c)");
  dshow("1:m ~> (fn k -> prod[j = 1:k] (1 - (j - 1) / 365)) |> (fn p -> find(p < 0.5)[1]) where m = 60");
  dshow("rng(7); rand(1, 500) |> {mu = mean, sd = std, hi = max, lo = min}");
  dshow("let zap = fn v -> pick(abs(v) < 1e-12, 0, v)");
  dshow("let fa = fn f, k -> integral(fn x -> f(x) * cos(k * x), -pi, pi) / pi");
  dshow("let fb = fn f, k -> integral(fn x -> f(x) * sin(k * x), -pi, pi) / pi");
  dshow("let spectrum = fn n -> {a = fn f -> zap(0:n ~> (fn k -> fa(f, k))), b = fn f -> zap(1:n ~> (fn k -> fb(f, k)))}");
  dshow("let s = spectrum(4);");
  dshow("(fn x -> x) |> {a = s.a, b = s.b}");
  null)

let demo_menu = fn -> (
  print("");
  print("  The Cozy tour — the book of examples, live.");
  print("  The demo and the book contain the same examples by construction.");
  print("");
  praw("  demo1  1. Basic calculations  (4 problems)");
  praw("  demo2  2. Values and types  (3 problems)");
  praw("  demo3  3. Strings  (5 problems)");
  praw("  demo4  4. Complex numbers  (3 problems)");
  praw("  demo5  5. Matrices  (4 problems)");
  praw("  demo6  6. Reading and writing data  (2 problems)");
  praw("  demo7  7. Writing your own functions  (3 problems)");
  praw("  demo8  8. Anonymous functions and pipes  (2 problems)");
  praw("  demo9  9. Records  (3 problems)");
  praw("  demo10  10. Calculus  (10 problems)");
  praw("  demo11  11. Linear algebra  (4 problems)");
  praw("  demo12  12. Probability, statistics, and data  (4 problems)");
  praw("  demo13  13. Plotting  (3 problems)");
  praw("  demo14  14. The Cozy idiom  (5 problems)");
  praw("  demo15  15. The Cozy instruments  (9 problems)");
  print("");
  print("  Type a section name (demo15), then next to step through its problems.");
  print("  In the terminal REPL, demo() runs the guided tour instead.");
  null)

let demo_seclens = [4, 3, 5, 3, 4, 2, 3, 2, 3, 10, 4, 4, 3, 5, 9]
let demo_cursec = 0
let demo_curprob = 0
let demo_playprob = fn s2, k2 -> (
  if s2 == 1 & k2 == 1 then (dhead("1.1 — Splitting the bill");
    dshow("format(\"fixed\", 2)");
    dshow("let bill = 87.40; bill * 1.15");
    dshow("ans / 4");
    null) end;
  if s2 == 1 & k2 == 2 then (dhead("1.2 — How much paint?");
    dshow("let area = 2 * (5.2 + 3.8) * 2.6 - 1.9 * 0.9 - 2 * 1.2 * 1.4;");
    dshow("area");
    dshow("area / 10");
    dshow("ceil(ans)");
    null) end;
  if s2 == 1 & k2 == 3 then (dhead("1.3 — Growth rates");
    dshow("format(4)");
    dshow("(68.4 / 51.2) ^ (1 / 6) - 1");
    dshow("let years = fn r -> log(2) / log(1 + r); years(ans)");
    null) end;
  if s2 == 1 & k2 == 4 then (dhead("1.4 — A currency helper");
    dshow("format(\"fixed\", 2)");
    dshow("let eur = fn usd -> usd / 1.0865;");
    dshow("eur(1500)");
    dshow("[19.99, 45.50, 129] ~> eur");
    null) end;
  if s2 == 2 & k2 == 1 then (dhead("2.1 — The type zoo");
    dshow("let n = 42; let x = 2.5; let ok = true; let s = \"helium\";");
    dshow("let v = [1.5, 2.5]; let M = [1, 2; 3, 4]; let z = 3 + 4i;");
    dshow("let r = {name = \"boron\", Z = 5}; let f = fn t -> t ^ 2;");
    dshow("who");
    null) end;
  if s2 == 2 & k2 == 2 then (dhead("2.2 — How numbers behave");
    dshow("7 / 2");
    dshow("2 ^ 10");
    dshow("2 ^ 0.5");
    dshow("floor(7 / 2)");
    dshow("[1, 5, 2, 8] > 3");
    dshow("sum([1, 5, 2, 8] > 3)");
    dshow("pick(true, 10, 20)");
    null) end;
  if s2 == 2 & k2 == 3 then (dhead("2.3 — Floating-point honesty");
    dshow("0.1 + 0.2 == 0.3");
    dshow("abs(0.1 + 0.2 - 0.3) < eps * 4");
    dshow("1 / 0");
    dshow("-1 / 0");
    dshow("0 / 0");
    dshow("nan == nan");
    null) end;
  if s2 == 3 & k2 == 1 then (dhead("3.1 — Cleanup and assembly");
    dshow("let name = \"  Cozy  \";");
    dshow("trim(name)");
    dshow("upper(ans)");
    dshow("length(trim(name))");
    dshow("\"version \" + str(2.5) + \", \" + str(153) + \" builtins\"");
    null) end;
  if s2 == 3 & k2 == 2 then (dhead("3.2 — Formatted reporting");
    dshow("fmt(\"pmt = {:.2f} at i = {:.4f}\", -1984.153, 0.0575 / 12)");
    dshow("fmt(\"{} of {} lots pass\", 18, 20)");
    null) end;
  if s2 == 3 & k2 == 3 then (dhead("3.3 — Parsing a data line");
    dshow("let csvline = \"2026-07-25,close,187.44\";");
    dshow("let parts = strsplit(csvline, \",\")");
    dshow("num(parts[3])");
    dshow("strjoin(parts, \" | \")");
    dshow("strrep(csvline, \",\", \";\")");
    null) end;
  if s2 == 3 & k2 == 4 then (dhead("3.4 — Predicates over listings");
    dshow("ls(\"packages\")");
    dshow("ans ~> (fn f -> endswith(f, \".cz\")) |> all");
    dshow("ls(\"packages\") ~> (fn f -> contains(f, \"s\")) |> sum");
    null) end;
  if s2 == 3 & k2 == 5 then (dhead("3.5 — Between text and values");
    dshow("strsplit(\"3.14, 2.71, 1.41\", \",\") ~> trim ~> num");
    dshow("strsplit(\"10 20 30\", \" \") ~> num |> sum");
    dshow("[1.5, 2.5, 3.5] ~> str |> (fn a -> strjoin(a, \" | \"))");
    dshow("let r = {rate = 0.0575, n = 360}; str(r)");
    dshow("fields(r)");
    null) end;
  if s2 == 4 & k2 == 1 then (dhead("4.1 — Impedance of a series RLC circuit");
    dshow("format(4)");
    dshow("let f = 60; let R = 100; let L = 0.25; let C = 20e-6;");
    dshow("let w = 2 * pi * f;");
    dshow("let Z = R + 1i * w * L + 1 / (1i * w * C)");
    dshow("abs(Z)");
    dshow("angle(Z) * 180 / pi");
    dshow("230 / abs(Z)");
    null) end;
  if s2 == 4 & k2 == 2 then (dhead("4.2 — Fifth roots of unity");
    dshow("format(4)");
    dshow("let z = exp(2i * pi / 5)");
    dshow("let zpow = fn n -> prod[k = 1:n] z");
    dshow("abs(zpow(5) - 1) < 1e-12");
    dshow("abs(sum[k = 0:4] zpow(k)) < 1e-12");
    dshow("abs(z - 1)");
    null) end;
  if s2 == 4 & k2 == 3 then (dhead("4.3 — Rotation as multiplication");
    dshow("format(4)");
    dshow("let p = 3 + 2i;");
    dshow("p * exp(1i * pi / 3)");
    dshow("abs(ans - p)");
    null) end;
  if s2 == 5 & k2 == 1 then (dhead("5.1 — The construction kit");
    dshow("let A = [1, 2; 3, 4]");
    dshow("zeros(2, 3)");
    dshow("eye(3)");
    dshow("diag([5, 6, 7])");
    dshow("reshape(1:6, 2, 3)");
    dshow("repmat([1, 0], 2, 2)");
    dshow("let B = eye(2); [A; B]");
    dshow("[A, A]");
    null) end;
  if s2 == 5 & k2 == 2 then (dhead("5.2 — Getting at the elements");
    dshow("let A = reshape(1:12, 3, 4)");
    dshow("A[2, 3]");
    dshow("A[2, :]");
    dshow("A[:, 4]");
    dshow("A[1, 1] = 100; A");
    dshow("let v = [10, 20, 30, 40]; v[v > 15]");
    null) end;
  if s2 == 5 & k2 == 3 then (dhead("5.3 — Two multiplications");
    dshow("let A = [1, 2; 3, 4]; let B = [0, 1; 1, 0];");
    dshow("A + B");
    dshow("A * B");
    dshow("A .* B");
    dshow("A ^ 2");
    dshow("A .^ 2");
    dshow("A * 10 + 1");
    dshow("A.'");
    null) end;
  if s2 == 5 & k2 == 4 then (dhead("5.4 — What you see");
    dshow("let A = [1/3, 2/3; 1, 4/3];");
    dshow("A");
    dshow("format(10); A");
    dshow("format(6);");
    dshow("size(A)");
    dshow("numel(A)");
    dshow("let big = rand(50, 50); size(big)");
    dshow("who");
    null) end;
  if s2 == 6 & k2 == 1 then (dhead("6.1 — Round-trip through a file");
    dshow("format(4)");
    dshow("rng(5)");
    dshow("let yield_data = [10 + randn(1, 6) * 0.5; 12 + randn(1, 6) * 0.5].';");
    dshow("writecsv(\"/tmp/yield.csv\", yield_data)");
    dshow("let back = readcsv(\"/tmp/yield.csv\");");
    dshow("size(back)");
    dshow("mean(back, 1)");
    dshow("corr(back[:, 1], back[:, 2])");
    null) end;
  if s2 == 6 & k2 == 2 then (dhead("6.2 — A table with names");
    dshow("let w = readtable(\"tests/data/weather.csv\")");
    dshow("mean(w.temp)");
    dshow("sum(w.rain > 0)");
    dshow("w.temp[find(w.rain == 0)]");
    dshow("w.temp |> {hi = max, lo = min, mu = mean}");
    null) end;
  if s2 == 7 & k2 == 1 then (dhead("7.1 — A progressive tax");
    dshow("format(\"fixed\", 2)");
    dshow("let tax = fn inc -> if inc <= 11000 then inc * 0.10 elseif inc <= 44725 then 1100 + (inc - 11000) * 0.12 else 5147 + (inc - 44725) * 0.22 end");
    dshow("tax(9500)");
    dshow("tax(30000)");
    dshow("tax(60000)");
    null) end;
  if s2 == 7 & k2 == 2 then (dhead("7.2 — Euclid, verbatim");
    dshow("let gcd = fn a, b -> if b == 0 then a else gcd(b, mod(a, b)) end");
    dshow("gcd(1071, 462)");
    dshow("gcd(35, 64)");
    null) end;
  if s2 == 7 & k2 == 3 then (dhead("7.3 — Body mass index, with provenance");
    dshow("format(3)");
    dshow("let bmi = fn kg, cm -> kg / (cm / 100) ^ 2");
    dshow("bmi(82, 178)");
    dshow("body(bmi)");
    null) end;
  if s2 == 8 & k2 == 1 then (dhead("8.1 — The pipe family on one array");
    dshow("format(4)");
    dshow("let x = [3, 1, 4, 1, 5, 9, 2, 6];");
    dshow("x |> sort");
    dshow("x ~> (@ ^ 2 - 1)");
    dshow("x |> sort |>> (@) |> median");
    dshow("x |> {n = length, mu = mean, rng = fn v -> max(v) - min(v)}");
    null) end;
  if s2 == 8 & k2 == 2 then (dhead("8.2 — Weekly payroll with overtime");
    dshow("format(\"fixed\", 2)");
    dshow("let hours = [38, 42.5, 40, 45, 36.5];");
    dshow("hours ~> (fn h -> if h <= 40 then h * 22 else 880 + (h - 40) * 33 end)");
    dshow("ans |> sum");
    null) end;
  if s2 == 9 & k2 == 1 then (dhead("9.1 — A parts bin");
    dshow("format(\"fixed\", 2)");
    dshow("let bolt = {sku = \"M8x40\", price = 0.42, stock = 1180};");
    dshow("let nut = {sku = \"M8n\", price = 0.11, stock = 2600};");
    dshow("bolt.price * 200 + nut.price * 200");
    dshow("fields(bolt)");
    dshow("let bolt = {sku = bolt.sku, price = bolt.price * 1.06, stock = bolt.stock}; bolt.price");
    null) end;
  if s2 == 9 & k2 == 2 then (dhead("9.2 — A measurement report");
    dshow("rng(3); format(4)");
