% schur.cz — the Schur decomposition against what a Schur form must satisfy,
% on about nine hundred matrices (seeded: reproducible): random dense ones of
% every size to 40, real and complex, and the awkward kinds — orthogonal,
% symmetric, skew, cyclic shifts, companion, graded, triangular either way
% round, rank one, sizes from 1e-300 to 1e300, defective and repeated spectra.
% Run under each backend (make stress, make BACKEND=openblas stress): the
% built-in kernels and LAPACK's must both pass.
%
% For each decomposition:
%   recon: max |U T U' - A| / max(1, |A|)      orth: max |U'U - I|
%   shape: 0 if T has the right shape (real form: quasi-triangular, 2x2 blocks standardised
%          with complex eigenvalues; complex form: triangular)
%   spec:  largest distance from an eigenvalue read off T to the nearest one eig(A) reports
let blocks_ok = fn T -> (
  let n = size(T)[1]; let bad = 0; let i = 1;
  for r = 3 : n do for c = 1 : r - 2 do if T[r, c] != 0 then (bad = bad + 1) end end end;
  while i <= n do (
    if (i < n) && (T[min(i + 1, n), i] != 0) then (
      let a = T[i, i]; let d = T[i + 1, i + 1]; let b = T[i, i + 1]; let c = T[i + 1, i];
      if a != d then (bad = bad + 1) end;
      if !(b * c < 0) then (bad = bad + 1) end;
      if (i + 2 <= n) && (T[min(i + 2, n), i + 1] != 0) then (bad = bad + 1) end;
      i = i + 2
    ) else (i = i + 1) end
  ) end;
  bad
)
let tri_ok = fn T -> (
  let n = size(T)[1]; let bad = 0;
  for r = 2 : n do for c = 1 : r - 1 do if abs(T[r, c]) != 0 then (bad = bad + 1) end end end;
  bad
)
let spectrum = fn T -> (
  let n = size(T)[1]; let w = zeros(n, 1) + 0i; let i = 1;
  while i <= n do (
    if (i < n) && (abs(T[min(i + 1, n), i]) != 0) then (
      let m = (T[i, i] + T[i + 1, i + 1]) / 2;
      let q = sqrt(T[i, i + 1] * T[i + 1, i] + 0i);
      w[i] = m + q; w[i + 1] = m - q; i = i + 2
    ) else ( w[i] = T[i, i]; i = i + 1 ) end
  ) end;
  w
)
let nearest = fn w, v -> (
  let worst = 0.0;
  for i = 1 : numel(w) do worst = max(worst, min(abs(v - w[i]))) end;
  worst
)
let check = fn A, kind -> (
  let n = size(A)[1];
  let s = if kind == "complex" then schur(A, "complex") else schur(A) end;
  let scale = max(1.0, max(abs(A)));
  let recon = max(abs(s.U * s.T * s.U' - A)) / scale;
  let orth = max(abs(s.U' * s.U - eye(n)));
  let shape = if kind == "real" then blocks_ok(s.T) else tri_ok(s.T) end;
  let spec = nearest(spectrum(s.T), eig(A).values) / scale;
  [recon, orth, shape, spec]
)
let worst = zeros(1, 4); let count = 0; let suspects = 0;
let note = fn name, r -> (
  worst = max(worst, r); count = count + 1;
  if !((r[1] < 1e-12) && (r[2] < 1e-12) && (r[3] == 0) && (r[4] < 1e-9)) then ( suspects = suspects + 1; print("  SUSPECT", name, r) ) end
)
rng(20261123);
% random dense, all sizes
for n = 1 : 40 do for rep = 1 : 6 do (
  let A = randn(n, n);
  note("dense", check(A, "real")); note("dense/complex", check(A, "complex"));
  note("zdense", check(A + 1i * randn(n, n), "cplx"))
) end end;
print("  random dense:", count, "decompositions, worst [recon, orth, shape, spec] =", worst);
worst = zeros(1, 4);
% structured and awkward
for n = [2, 3, 4, 5, 8, 13, 21, 34] do (
  let R = randn(n, n);
  let Q = qr(R).Q;
  note("orthogonal", check(Q, "real")); note("orthogonal/complex", check(Q, "complex"));
  note("symmetric", check(R + R', "real"));
  note("skew", check(R - R', "real")); note("skew/complex", check(R - R', "complex"));
  let P = zeros(n, n); for i = 1 : n do P[i, mod(i, n) + 1] = 1.0 end;
  note("cyclic shift", check(P, "real")); note("cyclic shift/complex", check(P, "complex"));
  let C = zeros(n, n); for i = 2 : n do C[i, i - 1] = 1.0 end; C[1, :] = randn(1, n);
  note("companion", check(C, "real"));
  let G = diag(10 .^ linspace(-8, 8, n)) * R;
  note("graded", check(G, "real"));
  % extreme sizes: the checks are made on T / sc, where the test's own arithmetic is safe
  for sc = [1e-300, 1e-150, 1e150, 1e300] do (
    let s2 = schur(sc * R); let T2 = s2.T / sc;
    note("scaled", [max(abs(s2.U * T2 * s2.U' - R)), max(abs(s2.U' * s2.U - eye(n))), blocks_ok(T2), nearest(spectrum(T2), eig(R).values)]);
    let s3 = schur(sc * R, "complex"); let T3 = s3.T / sc;
    note("scaled/complex", [max(abs(s3.U * T3 * s3.U' - R)), max(abs(s3.U' * s3.U - eye(n))), tri_ok(T3), nearest(spectrum(T3), eig(R).values)])
  ) end;
  let Up = R; for r = 2 : n do for c = 1 : r - 1 do Up[r, c] = 0.0 end end;
  note("upper triangular", check(Up, "real")); note("lower triangular", check(Up', "real"));
  note("rank one", check(randn(n, 1) * randn(1, n), "real"));
  note("identity", check(eye(n), "real")); note("zero", check(zeros(n, n), "real"));
  note("integers", check(round(3 * R), "real"))
) end;
print("  structured:", count, "in all, worst =", worst);
worst = zeros(1, 4);
% defective and repeated spectra: the eigenvalues themselves are ill-conditioned, so only the
% decomposition is held to rounding error
for n = [2, 3, 5, 8] do (
  let J = 2.0 * eye(n); for i = 1 : n - 1 do J[i, i + 1] = 1.0 end;
  let Q = qr(randn(n, n)).Q;
  let r = check(Q * J * Q', "real"); note("jordan", [r[1], r[2], r[3], 0.0]);
  let N = zeros(n, n); for i = 1 : n - 1 do N[i, i + 1] = 1.0 end;
  let r = check(Q * N * Q', "real"); note("nilpotent", [r[1], r[2], r[3], 0.0]);
  let D = Q * diag(round(linspace(1, 2, n))) * Q';
  note("repeated", check(D, "real"));
  let Rot = eye(2 * n); for i = 1 : n do ( Rot[2*i-1, 2*i-1] = 0.6; Rot[2*i, 2*i] = 0.6; Rot[2*i-1, 2*i] = -0.8; Rot[2*i, 2*i-1] = 0.8 ) end;
  let Q2 = qr(randn(2 * n, 2 * n)).Q;
  let r = check(Q2 * Rot * Q2', "real"); note("repeated complex pairs", [r[1], r[2], r[3], 0.0])
) end;
print("  defective / repeated:", count, "in all, worst =", worst);
let A = randn(150, 150); let s = schur(A);
note("150 x 150", [max(abs(s.U * s.T * s.U' - A)), max(abs(s.U' * s.U - eye(150))), blocks_ok(s.T), 0.0]);
assert(suspects == 0, "schur: a decomposition failed its checks");
print("schur: all green")
