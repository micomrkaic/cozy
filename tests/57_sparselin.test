# sparselin.cz — iterative sparse linear algebra as packages (design entry 1:
# solvers built on the founding kernel S * v). Assertions are invariants:
# residuals, known spectra, finite termination — never iterate internals.
load("packages/sparselin.cz"); cg(sparse([4, 1, 0; 1, 3, 1; 0, 1, 5]), [1; 2; 3]).relres < 1e-9
=> true
load("packages/sparselin.cz"); let A = sparse([4, 1, 0; 1, 3, 1; 0, 1, 5]); let s = cg(A, [1; 2; 3]); sl_norm(dense(A) * s.x - [1; 2; 3]) < 1e-8
=> true
load("packages/sparselin.cz"); cg(sparse([4, 1, 0; 1, 3, 1; 0, 1, 5]), [1; 2; 3]).iters <= 3
=> true
load("packages/sparselin.cz"); cg(speye(5), [9; 9; 9; 9; 9]).iters
=> 1
load("packages/sparselin.cz"); cg(sparse([4, 0; 0, 4]), [0; 0]).iters
=> 0
load("packages/sparselin.cz"); abs(powerit(sparse([2, 1; 1, 2])).value - 3) < 1e-9
=> true
load("packages/sparselin.cz"); abs(powerit(speye(4)).value - 1) < 1e-12
=> true
load("packages/sparselin.cz"); abs(powerit(sparse([1;2;3;1;2;2;3], [1;2;3;2;1;3;2], [2;2;2;-1;-1;-1;-1], 3, 3)).value - (2 + sqrt(2))) < 1e-6
=> true
load("packages/sparselin.cz"); let p = powerit(sparse([2, 1; 1, 2])); sl_norm(dense(sparse([2, 1; 1, 2])) * p.vector - p.value * p.vector) < 1e-6
=> true
load("packages/sparselin.cz"); abs(sl_norm(powerit(sparse([2, 1; 1, 2])).vector) - 1) < 1e-12
=> true
# the teaching gates on dense-only kernels
eig(speye(2))
=> !eig on sparse is not supported
inv(speye(2))
=> !inv on sparse is not supported
det(speye(2))
=> !det on sparse is not supported
svd(speye(2))
=> !svd on sparse is not supported
