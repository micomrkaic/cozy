# dsge.cz — a mini Dynare: steady state, exact linearisation, cyclic
# reduction, Blanchard-Kahn, impulse responses, moments.
# The reference numbers come from tests/ref_dsge.py, which shares nothing
# with the package: scipy's fsolve for the steady state, sympy's symbolic
# Jacobians, an ordered QZ decomposition for the decision rule, and
# scipy's Lyapunov solver for the moments. The New Keynesian responses are
# also Gali's closed form (2015, ch. 3). Assertions are closeness to those
# references, never printed digits of an iterative result, so they hold
# under every linear-algebra backend.

# --- the stochastic growth model (dsge.rbc) ---------------------------
load("dsge"); let m = dsge.model(dsge.rbc()); [m.n, m.k]
=> [5, 1]
.. m.lead
=> [0, 1, 0, 0, 1]
.. m.lag
=> [0, 0, 0, 1, 1]
.. let s = dsge.solve(m); max(abs(s.ybar - [3.0153277085; 2.306617232; 0.7087104765; 28.348419061; 0])) < 1e-8
=> true
.. abs(s.ss.k - (0.33 / (1 / 0.99 - 1 + 0.025))^(1 / 0.67)) < 1e-10
=> true
.. max(abs(s.P[:, 4] - [0.0351010101; 0.0480395296; -0.0129385195; 0.9620614805; 0])) < 1e-9
=> true
.. max(abs(s.P[:, 5] - [2.8645613231; 0.7074574765; 2.1571038466; 2.1571038466; 0.95])) < 1e-9
=> true
.. max(max(abs(s.P[:, 1:3])))
=> 0
.. max(abs(s.Q - [3.0153277085; 0.7446920806; 2.2706356279; 2.2706356279; 1])) < 1e-9
=> true
.. max(abs(s.roots[1:3, 1] - [0.95; 0.9620614805; 1.0499339498])) < 1e-9
=> true
.. s.roots[4]
=> inf
# the two capital roots are a reciprocal pair around 1/sqrt(beta)
.. abs(s.roots[2] * s.roots[3] - 1 / 0.99) < 1e-9
=> true
.. let b = dsge.bk(m); [b.unstable, b.forward]
=> [2, 2]
.. b.verdict
=> "determinate"
.. let q = dsge.moments(s); max(abs(q.sd - [0.1292878876; 0.0778165375; 0.0635742079; 1.2570734952; 0.0320256308])) < 1e-9
=> true
.. abs(q.corr[1, 2] - 0.9308012824716726) < 1e-9
=> true
.. max(abs(q.acorr[5, :] - 0.95 .^ (1:5))) < 1e-12
=> true
.. max(abs(q.mean - s.ybar))
=> 0
.. max(abs(dsge.vardecomp(s) - 100))  < 1e-9
=> true
.. let r = dsge.irf(s, "e", 30); abs(r.a[1] - 0.01) < 1e-15
=> true
.. max(abs(r.a - 0.01 * 0.95 .^ (0:29)')) < 1e-15
=> true
.. max(abs(r.y - r.c - r.i)) < 1e-14
=> true
.. abs(r.k[1] - 0.01 * 2.2706356279) < 1e-10
=> true
.. fields(r)
=> ["y"; "c"; "i"; "k"; "a"]
.. length(dsge.irf(s, "e").k)
=> 40
.. rng(5); let x = dsge.simulate(s, 60); length(x.k)
=> 60
.. max(abs(x.y - x.c - x.i)) < 1e-12
=> true
.. rng(5); let x2 = dsge.simulate(s, 60); max(abs(x.k - x2.k))
=> 0
# parameter overrides re-solve without recompiling
.. let s2 = dsge.solve(m, {sigma = 2.0, beta = 0.98}); max(abs(s2.ybar - [2.6562062442; 2.1736123682; 0.4825938761; 19.3037550423; 0])) < 1e-8
=> true
.. max(abs(s2.P[:, 4] - [0.0454081633; 0.0517976511; -0.0063894878; 0.9686105122; 0])) < 1e-9
=> true
.. max(abs(s2.Q - [2.6562062442; 0.9287078488; 1.7274983954; 1.7274983954; 1])) < 1e-9
=> true
.. s2.params.sigma
=> 2
.. m.params.sigma
=> 1
.. abs(dsge.steady(m, {beta = 0.98}).k - 19.3037550423) < 1e-8
=> true

# --- the New Keynesian model (dsge.nk): Gali's closed form ------------
load("dsge"); let nk = dsge.model(dsge.nk()); let s = dsge.solve(nk); max(abs(s.Q[:, 2] - [-1.1396332863; -0.2877291961; 0.4259520451; 0; 1])) < 1e-9
=> true
.. let L = 1 / ((1 - 0.99 * 0.5) * (1.0 * (1 - 0.5) + 0.125) + 0.1275 * (1.5 - 0.5)); max(abs(s.Q[1:2, 2] - [-(1 - 0.99 * 0.5) * L; -0.1275 * L])) < 1e-12
=> true
.. max(abs(s.Q[:, 1] - [1.0789408562; 1.2620638456; 2.0279633754; 1; 0])) < 1e-9
=> true
.. max(abs(s.roots - [0.5; 0.9; 1.1530591722; 1.1530591722])) < 1e-9
=> true
.. max(abs(dsge.moments(s).sd - [0.7008297694; 0.7285932131; 1.1695983091; 0.5735393347; 0.2886751346])) < 1e-9
=> true
.. max(max(abs(dsge.vardecomp(s)[1:3, :] - [77.9644485849, 22.0355514151; 98.7003800315, 1.2996199685; 98.894734266, 1.105265734]))) < 1e-7
=> true
.. max(abs(sum(dsge.vardecomp(s), 2) - 100)) < 1e-10
=> true
.. let r = dsge.irf(s, "ev", 12); max(abs(r.pi - 0.25 * -0.2877291961 * 0.5 .^ (0:11)')) < 1e-9
=> true
# the Taylor principle: determinate iff kappa (phi_pi - 1) + (1 - beta) phi_x > 0
.. dsge.bk(nk, {phi_pi = 0.9}).verdict
=> "indeterminate"
.. let b = dsge.bk(nk, {phi_pi = 0.9}); [b.unstable, b.forward]
=> [1, 2]
.. b.ok
=> false
.. dsge.bk(nk, {phi_pi = 1.0}).verdict
=> "determinate"
.. dsge.bk(nk, {phi_pi = 1.0, phi_x = 0.0}).ok
=> false
.. let edge = 1 - (1 - 0.99) * 0.125 / 0.1275; [dsge.bk(nk, {phi_pi = edge + 0.01}).ok, dsge.bk(nk, {phi_pi = edge - 0.01}).ok]
=> [true, false]
.. dsge.solve(nk, {phi_pi = 0.9})
=> !dsge: indeterminacy — 1 unstable root(s) for 2 forward-looking variable(s)

# --- Hansen's model with labour: eight variables, steady state by Newton
load("dsge"); let h = dsge.model({vars = "y c i k n w r a", shocks = "e", params = {alpha = 0.36, beta = 0.99, delta = 0.025, rho = 0.95, psi = 1.75}, sd = {e = 0.007}, init = {y = 1.0, c = 0.8, i = 0.2, k = 10.0, n = 0.3, w = 2.0, r = 0.04, a = 0.0}, model = ["1 / c = beta / c(+1) * (r(+1) + 1 - delta)"; "psi * c / (1 - n) = w"; "y = exp(a) * k(-1)^alpha * n^(1 - alpha)"; "w = (1 - alpha) * y / n"; "r = alpha * y / k(-1)"; "k = (1 - delta) * k(-1) + i"; "y = c + i"; "a = rho * a(-1) + e"]}); let s = dsge.solve(h); max(abs(s.ybar - [1.2211424247; 0.9080379929; 0.3131044318; 12.5241772708; 0.3296768455; 2.3705976394; 0.0351010101; 0])) < 1e-8
=> true
.. max(abs(s.P[:, 4] - [0.019809205; 0.0412353395; -0.0214261345; 0.9535738655; -0.0064506118; 0.0848397353; -0.0022332562; 0])) < 1e-9
=> true
.. max(abs(s.Q - [1.7783621826; 0.3565565104; 1.4218056721; 1.4218056721; 0.2350545485; 1.7621256901; 0.0511179594; 1])) < 1e-9
=> true
.. max(abs(dsge.moments(s).sd - [0.0467616116; 0.025724641; 0.0260882989; 0.4763030327; 0.0039156314; 0.0731452344; 0.000893155; 0.0224179415])) < 1e-9
=> true
.. max(abs(s.roots[1:3, 1] - [0.95; 0.9535738655; 1.0592792511])) < 1e-9
=> true
.. dsge.bk(h).verdict
=> "determinate"

# --- small models with known answers ----------------------------------
# a hybrid Phillips curve: the stable root of gf d^2 - d + gb = 0 is 1/2
load("dsge"); let hy = dsge.model({vars = "pi x", shocks = "e", params = {gf = 0.6, gb = 0.35, kappa = 0.1, rho = 0.8}, model = ["pi = gf * pi(+1) + gb * pi(-1) + kappa * x"; "x = rho * x(-1) + e"], init = {pi = 0.0, x = 0.0}}); let s = dsge.solve(hy); let psi = 0.1 / (1 - 0.6 * 0.5 - 0.6 * 0.8); max(max(abs([s.P, s.Q] - [0.5, 0.8 * psi, psi; 0, 0.8, 1]))) < 1e-12
=> true
.. max(abs(s.roots - [0.5; 0.8; 7 / 6])) < 1e-10
=> true
# purely forward-looking: x = r E x(+1) + e has P = 0, Q = 1 when r < 1
load("dsge"); let one = fn eq, r -> dsge.model({vars = "x", shocks = "e", params = {r = r}, model = [eq], init = {x = 0.0}}); let f = dsge.solve(one("x = r * x(+1) + e", 0.5)); [f.P, f.Q]
=> [0, 1]
.. dsge.bk(one("x = r * x(+1) + e", 2.0)).verdict
=> "indeterminate"
.. dsge.bk(one("x = r * x(-1) + e", 2.0)).verdict
=> "explosive"
# a bare expression means "= 0"; AR(1) variance is sd^2 / (1 - r^2)
.. let a = dsge.solve(one("x - r * x(-1) - e", 0.6)); abs(dsge.moments(a).var[1, 1] - 1 / (1 - 0.36)) < 1e-12
=> true
# a unit root solves (as in Dynare) but has no unconditional moments
.. let u = dsge.solve(one("x = r * x(-1) + e", 1.0)); [u.P, u.Q]
=> [1, 1]
.. dsge.moments(u)
=> !the model has a unit root
load("dsge"); dsge.solve(dsge.model({vars = "x", shocks = "e", params = {r = 2.0}, model = ["x = r * x(-1) + e"], init = {x = 0.0}}))
=> !dsge: no stable solution — 1 unstable root(s) for 0 forward-looking variable(s)
# complex roots admit no real decision rule, so cyclic reduction finds no
# solvent and the count comes from the companion pencil instead
load("dsge"); let two = fn eq -> dsge.model({vars = "x", shocks = "e", params = {r = 1.0}, model = [eq], init = {x = 0.0}}); let b = dsge.bk(two("x(+1) - x + 0.5 * x(-1) = e")); b.verdict
=> "indeterminate"
.. max(abs(b.roots - sqrt(0.5))) < 1e-9
=> true
.. let b2 = dsge.bk(two("x(+1) - 2 * x + 2 * x(-1) = e")); b2.verdict
=> "explosive"
.. max(abs(b2.roots - sqrt(2))) < 1e-9
=> true
.. dsge.bk(two("x(+1) - x + 0.25 * x(-1) = e")).verdict
=> "indeterminate"
# the two root counts agree: the pencil's finite nonzero roots are the solver's
load("dsge"); let big = dsge.model({vars = "a b c d", shocks = "e", params = {r = 0.9}, model = ["a = 0.5 * a(+1) + 0.2 * b(-1) + e"; "b = 0.4 * b(+1) + 0.3 * a + 0.1 * c(-1)"; "c = r * c(-1) + 0.1 * d(+1) + e"; "d = 0.3 * d(-1) + a(+1) - c"], init = {a = 0.0, b = 0.0, c = 0.0, d = 0.0}}); let b = dsge.bk(big); [b.unstable, b.forward]
=> [3, 3]
.. let L = dg_lin(big, big.params); let all = dg_roots(L.A, L.B, L.C); max(abs(all[2:7, 1] - b.roots)) < 1e-8
=> true
.. [all[1] < 1e-8, all[8] == inf]
=> [true, true]
# the steady function replaces the search, and is checked
load("dsge"); let w = dsge.model({vars = "x", shocks = "e", params = {r = 0.5, xbar = 4.0}, model = ["log(x) = r * log(x(-1)) + (1 - r) * log(xbar) + e"], steady = fn p -> {x = p.xbar}}); [dsge.steady(w).x, dsge.steady(w, {xbar = 9.0}).x]
=> [4, 9]
.. abs(dsge.solve(w).Q[1, 1] - 4) < 1e-12
=> true
load("dsge"); dsge.steady(dsge.model({vars = "x", shocks = "e", params = {r = 0.5}, model = ["log(x) = r * log(x(-1)) + e"], steady = fn p -> {x = 3.0}}))
=> !the steady function does not solve the model
# notation: spaces inside shifts, exponents, leading dots, Greek names,
# names that are prefixes of one another
load("dsge"); let g = dsge.model({vars = "c cc k1", shocks = "ε", params = {α = 0.5, b_2 = 0.25}, model = ["c = α * c(-1) + 1e-1 * cc + .5 * ε"; "cc = b_2 * cc ( - 1 ) + 2.5E-1 * k1(+1)"; "k1 = 0.5 * k1(+1) + c"], init = {c = 0.0, cc = 0.0, k1 = 0.0}}); [g.lead, g.lag]
=> [0, 0, 1, 1, 1, 0]
.. let s = dsge.solve(g); max(abs(s.Q - [0.50879677; 0.087967715; 0.68473220])) < 1e-7
=> true

# --- errors that teach ------------------------------------------------
load("dsge"); dsge.model({vars = "x y", shocks = "e", params = {r = 0.5}, model = ["x = r * x(-1) + e"]})
=> !1 equations for 2 variables
load("dsge"); dsge.model({vars = "x", shocks = "e", params = {r = 0.5}, model = ["x = r * z(-1) + e"]})
=> !equation 1: 'z' is not a variable, a shock, a parameter or a function
load("dsge"); dsge.model({vars = "x", shocks = "e", params = {r = 0.5}, model = ["x = r * x(-2) + e"]})
=> !only one lead or lag is supported; define an auxiliary variable
load("dsge"); dsge.model({vars = "x", shocks = "e", params = {r = 0.5}, model = ["x = r * x(-1) + e(-1)"]})
=> !the shock e cannot carry a lead or lag
load("dsge"); dsge.model({vars = "x", shocks = "e", params = {r = 0.5}, model = ["x = r * x(r) + e"]})
=> !'x(r)' is not a time shift
load("dsge"); dsge.model({vars = "x end", shocks = "e", params = {r = 0.5}, model = ["x = r * x(-1) + e"; "end = x"]})
=> !'end' is a reserved word
load("dsge"); dsge.model({vars = "x x", shocks = "e", params = {r = 0.5}, model = ["x = e"; "x = x"]})
=> !the variable 'x' is listed twice
load("dsge"); dsge.model({vars = "x", shocks = "x", params = {r = 0.5}, model = ["x = r * x(-1)"]})
=> !'x' is both a variable and a shock
load("dsge"); dsge.model({vars = "x", shocks = "e", params = {r = 0.5}, model = ["x = e"], foo = 1})
=> !unknown field 'foo'
load("dsge"); dsge.model({vars = "x", shocks = "e", params = {r = 0.5}})
=> !the model record needs a 'model' field
load("dsge"); dsge.model({vars = "x", shocks = "e", params = {r = 0.5}, model = ["x = r * x(-1) = e"]})
=> !equation 1 has more than one '='
load("dsge"); dsge.solve(dsge.model(dsge.rbc()), {q = 1})
=> !'q' is not a parameter of this model
load("dsge"); dsge.irf(dsge.solve(dsge.model(dsge.rbc())), "z")
=> !'z' is not a shock of this model (the shocks are e)
load("dsge"); dsge.model({vars = "x", shocks = "e", params = {r = 0.5}, model = ["x = e"], init = {z = 1}})
=> !init names 'z', which is not in the model
load("dsge"); dsge.steady(dsge.model({vars = "x", shocks = "e", params = {r = 0.5}, model = ["log(x) = r * log(x(-1)) + e"], init = {x = -1.0}}))
=> !cannot be evaluated at the starting values
load("dsge"); dsge.steady(dsge.model({vars = "x", shocks = "e", params = {r = 0.5}, model = ["x^2 + 1 = r * x(-1) + e"], init = {x = 3.0}}))
=> !no steady state found from these starting values
load("dsge"); dsge.steady(dsge.model({vars = "x y", shocks = "e", params = {r = 0.5}, model = ["x + y = 1 + e"; "2 * x + 2 * y = 2 + x(-1) - x"], init = {x = 3.0}}))
=> !the steady state is not locally unique
