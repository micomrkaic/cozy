# The power operator is part of the complex tower (0.1.32): a negative base
# with a fractional exponent has no real value and gives the principal
# complex one, as sqrt(-4) gives 2i. It used to give nan.
(-9)^(1/3)
=> 1.04004+1.80141i
(-8)^(1/3)
=> 1+1.73205i
abs(((-9)^(1/3))^3 + 9) < 1e-12
=> true
# the quarter turns are exact: no 1e-16 where a zero belongs
(-4)^0.5
=> 2i
(-4)^1.5
=> -8i
(-2.0)^-0.5
=> -0.707107i
(-1)^0.25
=> 0.707107+0.707107i
# the real cube root is cbrt
cbrt(-27)
=> -3
# an integer exponent keeps a negative base real, as before
[(-8)^2, (-8.0)^3, (-2)^-1]
=> [64, -512, -0.5]
[2^0.5, 2^-1, 0^0, 0.0^0.5]
=> [1.41421, 0.5, 1, 0]
# elementwise: only the entries that need it are the reason the array is complex
[-8, 8, 0] .^ (1/3)
=> [1+1.73205i, 2+0i, 0+0i]
[-4.0, 4.0] .^ 0.5
=> [2i, 2+0i]
(-8) .^ [1, 0.5, 2]
=> [-8+0i, 2.82843i, 64+0i]
# missing and infinite values are not "negative numbers": they stay with the reals
[nan^0.5, (-8)^nan, (-inf)^0.5, inf^0.5]
=> [nan, nan, inf, inf]

# a complex base or exponent (this used to be an error)
(1i)^2
=> -1+0i
(1+1i)^2
=> 2i
(1i)^-1
=> -1i
(2i)^0.5
=> 1+1i
2^(1i)
=> 0.769239+0.638961i
(1i)^(1i)
=> 0.20788+0i
(1+2i)^(3-1i)
=> -27.4364+19.7893i
(1+1i)^0
=> 1+0i
[1i, 2] .^ 2
=> [-1+0i, 4+0i]
[1+1i, 2-1i] .^ [0.5, 2]
=> [1.09868+0.45509i, 3-4i]
abs(exp((1/3) * log(-9+0i)) - (-9)^(1/3)) < 1e-12
=> true
# zero: 0^w is 0 when the real part of w is positive, 1 for w = 0, and has no value otherwise
[(0i)^2, (0i)^0, (0i)^0.5]
=> [0+0i, 1+0i, 0+0i]
(0i)^-1
=> nan+nani
(0i)^(1i)
=> nan+nani
# the cube roots of unity, cubed
format(6); real(eig([0, 1, 0; 0, 0, 1; 1, 0, 0]).values .^ 3)'
=> [1.00000, 1.00000, 1.00000]

# dual numbers do not mix with complex, so this case stays an error and says why
dualeps(dual(-2.0, 1.0)^3)
=> 12
dual(-2.0, 1.0)^0.5
=> !dual power: base must be positive
