# buildinfo — the dispatch seam's introspection (design entry 2).
# Law: the conformance suite doubles as the backend-equivalence harness, so
# these goldens assert structure and invariants only — NEVER the backend name
# ("tier0" here, "accelerate"/"openblas" under tier 1) and NEVER the build
# timestamp (fails at midnight). The record shape and the version cross-check
# are the same on every tier forever.
length(fields(buildinfo())) == 4
=> true
fields(buildinfo())[1] == "backend"
=> true
fields(buildinfo())[2] == "version"
=> true
fields(buildinfo())[3] == "built"
=> true
length(buildinfo().backend) > 0
=> true
buildinfo().version == version()
=> true
