# svd, eig and rcond at every scale (0.1.35).
#
# The built-in kernels used to decide they were finished by absolute
# numbers ("the off-diagonal part is below 1e-28"), and eig itself judged
# symmetry and noise against 1. A matrix of ordinary size never noticed. A
# matrix in small units did: svd was wrong below about 1e-7, eig of a
# symmetric matrix below about 1e-15, eig of any other matrix below about
# 1e-9. The rule these tests pin: for c > 0, svd(A * c).S is c * svd(A).S and
# eig(A * c).values is c * eig(A).values, and the vectors do not change.

# --- svd ---
format(8); svd([1, 2, 3; 4, 5, 6; 7, 8, 10]).S'
=> [17.412505, 0.87516135, 0.19686652]
# the same matrix in units of 1e-9 (this returned [17.412492, 0.68298804, 0.58193986])
format(8); svd([1, 2, 3; 4, 5, 6; 7, 8, 10] * 1e-9).S' * 1e9
=> [17.412505, 0.87516135, 0.19686652]
format(8); svd([1, 2, 3; 4, 5, 6; 7, 8, 10] * 1e-200).S' * 1e200
=> [17.412505, 0.87516135, 0.19686652]
format(8); svd([1, 2, 3; 4, 5, 6; 7, 8, 10] * 1e200).S' / 1e200
=> [17.412505, 0.87516135, 0.19686652]
# ... and its factors are what they should be: orthonormal columns, and the matrix back
let A = [1, 2, 3; 4, 5, 6; 7, 8, 10] * 1e-9; let f = svd(A); [max(max(abs(f.U' * f.U - eye(3)))) < 1e-13, max(max(abs(f.V' * f.V - eye(3)))) < 1e-13, max(max(abs(f.U * diag(f.S) * f.V' - A))) < 1e-22]
=> [true, true, true]
# a wide matrix and a complex one, small
let A = [1, 2, 3; 4, 5, 6] * 1e-12; max(abs(svd(A).S / 1e-12 - svd(A / 1e-12).S)) < 1e-12
=> true
let A = [1 + 2i, 3; 4i, 5 - 1i] * 1e-12; max(abs(svd(A).S / 1e-12 - svd(A / 1e-12).S)) < 1e-12
=> true
# forty columns of ordinary size: every pair orthogonal to rounding (and no longer sixty sweeps to get there)
rng(7); let A = randn(40, 40); let f = svd(A); [max(max(abs(f.U' * f.U - eye(40)))) < 1e-12, max(max(abs(f.U * diag(f.S) * f.V' - A))) < 1e-12]
=> [true, true]
# U has orthonormal columns even where a singular value is exactly zero
# (the built-in kernel used to leave a column of zeros there)
let f = svd(ones(4, 3)); max(max(abs(f.U' * f.U - eye(3)))) < 1e-13
=> true
let f = svd(ones(4, 3)); f.S[2] + f.S[3]
=> 0
let f = svd(zeros(3, 2)); max(max(abs(f.U' * f.U - eye(2)))) < 1e-13
=> true
let f = svd(zeros(3, 2)); f.S'
=> [0, 0]
let f = svd([1, 0; 0, 0; 0, 0]); [max(max(abs(f.U' * f.U - eye(2)))) < 1e-13, max(max(abs(f.U * diag(f.S) * f.V' - [1, 0; 0, 0; 0, 0]))) < 1e-13]
=> [true, true]

# --- eig, symmetric ---
max(abs(eig([2, 1; 1, 2]).values - [1; 3])) < 1e-13
=> true
# in units of 1e-16 (this returned the diagonal, [2e-16, 2e-16])
max(abs(eig([2, 1; 1, 2] * 1e-16).values / 1e-16 - [1; 3])) < 1e-12
=> true
max(abs(eig([2, 1; 1, 2] * 1e-200).values / 1e-200 - [1; 3])) < 1e-12
=> true
max(abs(eig([2, 1; 1, 2] * 1e200).values / 1e200 - [1; 3])) < 1e-12
=> true
let H = [2, 1; 1, 2] * 1e-16; let f = eig(H); [max(max(abs(f.vectors' * f.vectors - eye(2)))) < 1e-13, max(max(abs(H * f.vectors - f.vectors * diag(f.values)))) < 1e-30]
=> [true, true]
# Hermitian, small
let H = [2, 1 - 1i; 1 + 1i, 3] * 1e-20; max(abs(eig(H).values / 1e-20 - [1; 4])) < 1e-12
=> true
# large entries: the answer was right before, after a hundred sweeps
rng(8); let A = randn(30, 30); let H = (A + A') * 1000; let f = eig(H); max(max(abs(H * f.vectors - f.vectors * diag(f.values)))) < 1e-8
=> true

# --- eig, not symmetric ---
format(8); eig([1, 2; 3, 4]).values'
=> [-0.37228132, 5.3722813]
# in units of 1e-10 the matrix was taken for a symmetric one (2e-10 and 3e-10 differ by less than 1e-9)
format(8); eig([1, 2; 3, 4] * 1e-10).values' * 1e10
=> [-0.37228132, 5.3722813]
# ... and in units of 1e-14 both eigenvalues were "noise" and came back as 0
format(8); eig([1, 2; 3, 4] * 1e-14).values' * 1e14
=> [-0.37228132, 5.3722813]
format(8); eig([1, 2; 3, 4] * 1e-200).values' * 1e200
=> [-0.37228132, 5.3722813]
format(8); eig([1, 2; 3, 4] * 1e200).values' / 1e200
=> [-0.37228132, 5.3722813]
# a rotation, small: still a complex pair
max(abs(eig([0, -1; 1, 0] * 1e-13).values * 1e13 - [-1i; 1i])) < 1e-12
=> true
# the vectors do not depend on the units
max(max(abs(eig([1, 2; 3, 4] * 1e-14).vectors - eig([1, 2; 3, 4]).vectors))) < 1e-12
=> true
# a nearly symmetric matrix is still treated as symmetric: real eigenvalues, orthogonal vectors
let f = eig([2, 1; 1 + 1e-12, 2]); max(max(abs(f.vectors' * f.vectors - eye(2)))) < 1e-13
=> true
let f = eig([2, 1; 1 + 1e-12, 2] * 1e-20); max(max(abs(f.vectors' * f.vectors - eye(2)))) < 1e-13
=> true
# an eigenvalue that occurs twice with two eigenvectors: both are found
# (the built-in kernel used to return the same vector twice)
let S = [1, 2, 0; 0, 1, 3; 1, 0, 1]; let A = S * diag([2, 2, 5]) * inv(S); format(6); eig(A).values'
=> [2.00000, 2.00000, 5.00000]
let S = [1, 2, 0; 0, 1, 3; 1, 0, 1]; let A = S * diag([2, 2, 5]) * inv(S); let f = eig(A); max(max(abs(A * f.vectors - f.vectors * diag(f.values)))) < 1e-12
=> true
let S = [1, 2, 0; 0, 1, 3; 1, 0, 1]; let A = S * diag([2, 2, 5]) * inv(S); let sv = svd(eig(A).vectors).S; sv[3] / sv[1] > 1e-3
=> true
# a defective matrix has one eigenvector for its double eigenvalue, and gets it twice
eig([1, 1; 0, 1]).values'
=> [1, 1]
let V = eig([1, 1; 0, 1]).vectors; [max(abs(abs(V[1, :]) - 1)) < 1e-12, max(abs(V[2, :])) < 1e-12]
=> [true, true]
# every column of unit length, and the equation holds, for a matrix of size 40
rng(9); let A = randn(40, 40); let f = eig(A); let worst = 0.0; for j = 1 : 40 do (worst = max(worst, abs(norm(f.vectors[:, j]) - 1))) end; [worst < 1e-12, max(max(abs(A * f.vectors - f.vectors * diag(f.values)))) < 1e-11]
=> [true, true]

# --- rcond ---
rcond(eye(3))
=> 1
rcond([2, 0; 0, 4])
=> 0.5
format(6); rcond([1, 2; 3, 4])
=> 0.0476190
# it is 1 / (norm1(A) * norm1(inv(A))), the 1-norm being the largest column sum
let A = [4, 1, 2; 1, 5, 1; 2, 0, 6]; abs(rcond(A) * max(sum(abs(A), 1)) * max(sum(abs(inv(A)), 1)) - 1) < 1e-14
=> true
# the units do not matter
max(abs([rcond([1, 2; 3, 4] * 1e-200), rcond([1, 2; 3, 4] * 1e200)] - rcond([1, 2; 3, 4]))) < 1e-15
=> true
# a singular matrix: exactly 0 where elimination meets a zero pivot
rcond([1, 2; 2, 4])
=> 0
rcond(zeros(2, 2))
=> 0
rcond([1, 2, 3; 0, 0, 0; 4, 5, 6])
=> 0
# ... and of the size of rounding where it only nearly does
rcond([1, 2, 3; 4, 5, 6; 7, 8, 9]) < 1e-15
=> true
rcond([1, 1; 1, 1 + 1e-10]) < 1e-9
=> true
# numbers, complex matrices, empty ones
[rcond(7), rcond(-0.5), rcond(0), rcond(3 + 4i)]
=> [1, 1, 0, 1]
format(6); rcond([1i, 2; 3, 4i])
=> 0.238095
rcond(zeros(0, 0))
=> inf
# missing data propagates; an infinite entry is as singular as it gets
rcond([1, nan; 0, 1])
=> nan
rcond(nan)
=> nan
rcond([1, inf; 0, 1])
=> 0
rcond([1, 2, 3; 4, 5, 6])
=> !must be square
rcond("abc")
=> !rcond
rcond(dual(2.0, 1.0))
=> !rcond

# --- what was built on them ---
# the decision-rule solver asks rcond, not svd, whether it can go on; the answers are the same
load("dsge"); [dg_rcond(eye(3)), dg_rcond([1, 2; 2, 4]), dg_rcond([1, nan; 0, 1]), dg_rcond([1, inf; 0, 1])]
=> [1, 0, 0, 0]
load("dsge"); format(6); dg_rcond([1, 2; 3, 4])
=> 0.0476190
load("dsge"); [dg_size([1, -3; 2, 0]), dg_size([1, nan]), dg_size([1, -inf]), dg_size([1, 2i]), dg_size([1 + 0i, 2]), dg_size(zeros(2, 2))]
=> [3, inf, inf, inf, 2, 0]
load("dsge"); let s = dsge.solve(dsge.model(dsge.rbc())); format(6); [s.P[4, 4], s.P[1, 5], s.Q[2, 1]]
=> [0.962061, 2.86456, 0.744692]
