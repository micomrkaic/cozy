# optim.cz — multivariate optimization on autodiff (design entry 3).
# Assertions are invariants: convergence flags, residual norms, known
# optima within tolerance — never iteration counts pinned exactly, and
# no linalg kernel is involved, so these are backend-invariant by
# construction. The constrained cases are the owner's charter: the
# Cobb-Douglas budget maximum is the analytic (a m / p, b m / q).
load("packages/optim.cz"); minimize(fn x -> sum(x .* x), [3.0; 4.0])
=> {x = [0; 0], fx = 0, iters = 1, converged = true}
load("packages/optim.cz"); let r = minimize(fn x -> (1 - x[1])^2 + 100 * (x[2] - x[1]^2)^2, [-1.2; 1.0]); r.converged
=> true
load("packages/optim.cz"); let r = minimize(fn x -> (1 - x[1])^2 + 100 * (x[2] - x[1]^2)^2, [-1.2; 1.0]); sqrt(sum((r.x - [1.0; 1.0]) .* (r.x - [1.0; 1.0]))) < 1e-6
=> true
load("packages/optim.cz"); let r = minimize(fn x -> sum(x .* ([3.0, 1.0; 1.0, 2.0] * x)) - sum([1.0; 1.0] .* x), [0.0; 0.0]); r.converged
=> true
load("packages/optim.cz"); maximize(fn x -> -(x[1] - 2)^2 - (x[2] + 1)^2, [0.0; 0.0]).x
=> [2; -1]
load("packages/optim.cz"); maximize(fn x -> -(x[1] - 2)^2 - (x[2] + 1)^2, [0.0; 0.0]).fx
=> 0
load("packages/optim.cz"); minimize_box(fn x -> sum(x .* x), [3.0; 4.0], [1.0; -5.0], [5.0; 5.0]).x
=> [1; 0]
load("packages/optim.cz"); maximize_box(fn x -> sum(x), [0.0; 0.0], [-1.0; -1.0], [2.0; 3.0]).x
=> [2; 3]
load("packages/optim.cz"); let m = maximize_con(fn x -> x[1]^0.3 * x[2]^0.7, [1.0; 1.0], {eq = fn x -> [2 * x[1] + 3 * x[2] - 12]}); m.converged
=> true
load("packages/optim.cz"); let m = maximize_con(fn x -> x[1]^0.3 * x[2]^0.7, [1.0; 1.0], {eq = fn x -> [2 * x[1] + 3 * x[2] - 12]}); sqrt(sum((m.x - [1.8; 2.8]) .* (m.x - [1.8; 2.8]))) < 1e-5
=> true
load("packages/optim.cz"); let m = maximize_con(fn x -> x[1]^0.3 * x[2]^0.7, [1.0; 1.0], {eq = fn x -> [2 * x[1] + 3 * x[2] - 12]}); abs(2 * m.x[1] + 3 * m.x[2] - 12) < 1e-6
=> true
load("packages/optim.cz"); let m = minimize_con(fn x -> sum(x .* x), [3.0; 3.0], {ineq = fn x -> [x[1] + x[2] - 1]}); sqrt(sum(m.x .* m.x)) < 1e-6
=> true
load("packages/optim.cz"); let m = minimize_con(fn x -> sum((x - [2.0; 2.0]) .* (x - [2.0; 2.0])), [0.0; 0.0], {ineq = fn x -> [x[1] + x[2] - 2]}); sqrt(sum((m.x - [1.0; 1.0]) .* (m.x - [1.0; 1.0]))) < 1e-5
=> true
load("packages/optim.cz"); minimize(fn x -> sum(x .* x), [3.0; 4.0]).iters
=> 1
