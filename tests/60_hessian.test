# hyper-duals + exact Hessians + true Newton (entry 4a, second increment).
# The algebra is exact, so the asserts are equalities; Newton on a
# positive-definite quadratic converges in ONE iteration — that golden is
# the method's signature. No linalg kernel beyond \ on plain floats, so
# everything here is backend-invariant by the same suite that checks \.
hdual(3, 1, 1) * hdual(3, 1, 1)
=> 9+6eps1+6eps2+2eps12
hdual12(hdual(3, 1, 1) ^ 2)
=> 2
hdual12(hdual(2, 1, 0) * hdual(2, 0, 1))
=> 1
hdual12(sin(hdual(1, 1, 1))) == -sin(1)
=> true
hdual12(exp(hdual(0, 1, 1)))
=> 1
hdual12(log(hdual(2, 1, 1)))
=> -0.25
hdual12(sqrt(hdual(4, 1, 1))) == -1 / 32
=> true
hdualval(hdual(2, 1, 1))
=> 2
hdual12(7)
=> 0
hdualval(7)
=> 7
hdual12(abs(hdual(-3, 1, 1)))
=> 0
hdual(1, 1, 1) + 2i
=> !hyper-dual and complex do not mix
hdual(1, 1, 1) + dual(1, 1)
=> !dual and hyper-dual do not mix
dual(hdual(1, 1, 1), 1)
=> !components are already dual
gamma(hdual(3, 1, 1))
=> !second derivative needs trigamma
eig([hdual(1, 1, 1), 0; 0, 1.0])
=> !not supported
speye(2) * hdual(1, 1, 1)
=> !sparse and dual do not mix
load("packages/autodiff.cz"); hess(fn x -> sum(x .* x))([1.0; 2.0; 3.0])
=> [2, 0, 0; 0, 2, 0; 0, 0, 2]
load("packages/autodiff.cz"); hess(fn x -> x[1] * x[2]^2)([2.0; 3.0])
=> [0, 6; 6, 4]
load("packages/optim.cz"); minimize_newton(fn x -> sum(x .* ([3.0, 1.0; 1.0, 2.0] * x)) - sum([1.0; 1.0] .* x), [9.0; -7.0]).iters
=> 1
load("packages/optim.cz"); let r = minimize_newton(fn x -> (1 - x[1])^2 + 100 * (x[2] - x[1]^2)^2, [-1.2; 1.0]); r.converged & (sqrt(sum((r.x - [1.0; 1.0]) .* (r.x - [1.0; 1.0]))) < 1e-6)
=> true
load("packages/optim.cz"); maximize_newton(fn x -> -(x[1] - 2)^2 - (x[2] + 1)^2, [5.0; 5.0]).x
=> [2; -1]
