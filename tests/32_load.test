# load("file.cz"): run a file in the current session (fixtures in tests/data/)
load("tests/data/mathlib.cz"); cube(4)
=> 64
load("tests/data/mathlib.cz"); mean2([2, 4, 9])
=> 5
# record-of-closures as a module
load("tests/data/mathlib.cz"); geo.hyp([3, 4])
=> 5
load("tests/data/mathlib.cz"); geo.unit([3, 4])
=> [0.6, 0.8]
# packages loading packages
load("tests/data/chain.cz"); twelve
=> 12
# errors: circularity, parse, runtime, missing, wrong type
load("tests/data/circ.cz")
=> !nesting too deep
load("tests/data/badparse.cz")
=> !parse error in 'tests/data/badparse.cz'
load("tests/data/badrun.cz")
=> !undefined name 'definitely_undefined'
load("nonexistent.cz")
=> !cannot open
load(42)
=> !expected a file name string
# load returns null: silent on success
load("tests/data/mathlib.cz"); "ok"
=> "ok"
# multi-line expressions in files (newline is whitespace inside brackets)
load("tests/data/multiline.cz"); total
=> 20
