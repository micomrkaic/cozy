# Sparse (design entry 1, owner-triggered): the promotion law, stated once,
# tested forever. Zero-preserving stays sparse; zero-breaking gates teach.
nnz(sparse([0, 5; 3, 0]))
=> 2
size(sparse([0, 5; 3, 0]))
=> [2, 2]
dense(sparse([0, 5; 3, 0]))
=> [0, 5; 3, 0]
sparse([0, 5; 3, 0])[2, 1]
=> 3
sparse([0, 5; 3, 0])[1, 1]
=> 0
nnz(sparse([1; 1], [1; 1], [2; 3], 2, 2))
=> 1
sparse([1; 1], [1; 1], [2; 3], 2, 2)[1, 1]
=> 5
nnz(sparse([1], [1], [5], 2, 2) + sparse([1], [1], [-5], 2, 2))
=> 0
nnz(3 * sparse([0, 5; 3, 0]))
=> 2
nnz(0 * sparse([0, 5; 3, 0]))
=> 0
dense(sparse([0, 5; 3, 0]) + sparse([1, 0; 0, 0]))
=> [1, 5; 3, 0]
dense(sparse([0, 5; 3, 0]) .* sparse([0, 2; 0, 9]))
=> [0, 10; 0, 0]
dense(sparse([0, 5; 3, 0])')
=> [0, 3; 5, 0]
sparse([0, 5; 3, 0]) * [10; 100]
=> [500; 30]
speye(3) * [7; 8; 9]
=> [7; 8; 9]
nnz(speye(4))
=> 4
nnz(dense(speye(2)))
=> 2
size(sprand(9, 5, 0.2))
=> [9, 5]
# sprand asserts properties, not values: the sampling stream is an
# implementation detail; nnz, dims, and bounds are the contract.
nnz(sprand(20, 20, 0.1)) == 40
=> true
all(dense(sprand(6, 6, 0.5)) >= 0)
=> true
size(sprandn(6, 2, 0.5))
=> [6, 2]
sparse([0, 5; 3, 0]) + 1
=> !sparse + scalar would densify
sparse([0, 5; 3, 0]) * sparse([0, 5; 3, 0])
=> !not in the founding kernel set
sparse([0, 5; 3, 0]) \ [1; 2]
=> !sparse \ is not in the founding kernel set
sparse([0, 5; 3, 0]) / 0
=> !would densify
sparse([0, 5; 3, 0]) == sparse([0, 5; 3, 0])
=> !not supported
sparse([1], [5], [2], 2, 2)
=> !out of bounds
sparse([0, 5; 3, 0])[1, 3]
=> !out of bounds
sum(sparse([0, 5; 3, 0]))
=> !expected
